# WaveSpeed AI, text to image generation (https://wavespeed.ai)
WAVESPEED_API_KEY=

# OpenAI Images, the editorial CLI generator (gpt-image-2).
# Needs organisation verification in the OpenAI dashboard for gpt-image models.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Resend, transactional email (https://resend.com/api-keys)
RESEND_API_KEY=

# Recipient address for the contact form
CONTACT_TO_EMAIL=

# Optional sender override. Defaults to the Resend free-tier sender.
# Set this after verifying a custom domain in the Resend dashboard.
CONTACT_FROM_EMAIL=

# Secret used to sign the contact form math question.
# Any long random string. Falls back to RESEND_API_KEY when unset.
CONTACT_SECRET=
