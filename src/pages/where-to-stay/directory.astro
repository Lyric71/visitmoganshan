---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  STAYS_SEED,
  TYPE_BLURB,
  TYPE_ORDER,
  goPath,
  guessType,
  resolveStayHrefs,
  storefrontUrl,
  type StayType,
} from '../../lib/stays';

/**
 * /where-to-stay/directory
 *
 * Every property bookable around this mountain, all 809 of them, named and
 * linked. Nothing is hidden behind a search box.
 *
 * It lives here rather than at /where-to-stay because that path is already the
 * editorial hub for the section, a written page with a point of view about
 * where to sleep. Replacing an argument with a list would be a downgrade, and
 * Astro would refuse the collision anyway.
 *
 * One page rather than 809. A directory row is an honest artefact: it says this
 * place exists, here is what it appears to be, here is where to check dates. A
 * page per property assembled out of the same three fields would be 809 near
 * identical documents, which Google reads as doorway pages whatever the intent,
 * and the penalty lands on the whole domain rather than on the pages that
 * earned it. Properties graduate to a page of their own by clearing the content
 * bar in src/content.config.ts, and the ones that have are marked below.
 *
 * The type on each row is guessed from the name, and the page says so. The seed
 * carries no type field, and inventing a verified-looking fact is exactly what
 * this site exists not to do.
 */

// Where each written-up property lives. Most would be a page from the stays
// collection; a couple are researched articles that absorbed the property data
// instead, and those win. Either way a row resolves to one link.
const writtenUp = await resolveStayHrefs();

type Row = (typeof STAYS_SEED)[number] & { type: StayType };

const rows: Row[] = STAYS_SEED.map((row) => ({ ...row, type: guessType(row.name) })).sort((a, b) =>
  a.name.localeCompare(b.name, 'en'),
);

const groups = TYPE_ORDER.map((type) => ({
  type,
  id: type.toLowerCase(),
  blurb: TYPE_BLURB[type],
  items: rows.filter((row) => row.type === type),
})).filter((group) => group.items.length > 0);

const deqing = rows.filter((row) => row.city === 'Deqing').length;
const huzhou = rows.length - deqing;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Where to stay', href: '/where-to-stay' },
  { label: 'Every property', href: '/where-to-stay/directory' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Every place to stay around Moganshan',
  description: `A directory of ${rows.length} properties bookable around Moganshan, in Deqing county and Huzhou.`,
  url: new URL('/where-to-stay/directory', Astro.site).href,
  inLanguage: 'en',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.label,
      item: new URL(crumb.href, Astro.site).href.replace(/(?<!\/)\/$/, ''),
    })),
  },
};
---

<Layout
  title="Every place to stay around Moganshan, all 809 · Visit Moganshan"
  description="A directory of all 809 properties bookable around Moganshan: resorts, villas, minsu, hotels and lodges across Deqing county and Huzhou, each with a live rates link."
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />
  </Fragment>

  <SiteHeader />
  <Breadcrumbs crumbs={crumbs} />

  <main id="main">
    <div class="vm-container">
      <header class="head">
        <p class="vm-kicker">Where to stay</p>
        <h1>Every place to stay around Moganshan</h1>
        <p class="standfirst">
          All {rows.length.toLocaleString('en-GB')} properties bookable within reach of the mountain,
          named and linked: {deqing.toLocaleString('en-GB')} in Deqing county, where the mountain is,
          and {huzhou.toLocaleString('en-GB')} further out in Huzhou. Nothing here is ranked, nothing
          is promoted, and nobody has paid to appear.
        </p>
        <p class="caveat">
          We have stayed at almost none of these. What the list gives you is a complete picture of
          what exists and a link to live rates for each one. Where a property carries a written page
          of ours, with photographs, a description and one honest caveat, the name links to it.
        </p>
      </header>

      <nav class="jump" aria-label="Jump to a kind of place">
        <ul>
          {
            groups.map((group) => (
              <li>
                <a href={`#${group.id}`}>
                  {group.type === 'Unclassified' ? 'Unclassified' : `${group.type}s`}
                  <span class="jump__count">{group.items.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="jump__note">
          The kind of place is inferred from the property's own name, not verified by us. Treat it
          as a way to scan the list, not as a fact about the building.
        </p>
      </nav>

      {
        groups.map((group) => (
          <section class="group" id={group.id} aria-labelledby={`${group.id}-title`}>
            <h2 id={`${group.id}-title`}>
              {group.type === 'Unclassified' ? 'Everything else' : `${group.type}s`}
              <span class="group__count">{group.items.length}</span>
            </h2>
            <p class="group__blurb">{group.blurb}</p>

            <ul class="rows">
              {group.items.map((row) => {
                const href = writtenUp.get(row.id);
                return (
                  <li class="row">
                    <span class="row__name">
                      {href ? <a href={href}>{row.name}</a> : row.name}
                      {href && <span class="row__flag">Written up</span>}
                    </span>
                    <span class="row__city">{row.city}</span>
                    {/* aria-label rather than a visually hidden span: 809 rows
                        means 809 extra elements, and the label is the whole
                        accessible name anyway. Without it a screen reader hears
                        "Check dates" 809 times with nothing to tell them apart. */}
                    <a
                      class="row__cta"
                      href={goPath(row.goSlug)}
                      rel="sponsored noopener"
                      target="_blank"
                      aria-label={`Check dates for ${row.name} on Trip.com, opens in a new tab`}
                    >
                      Check dates
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }

      <section class="foot" aria-labelledby="foot-title">
        <h2 id="foot-title">If none of these is it</h2>
        <p>
          The list is the affiliate inventory for Deqing and Huzhou, so it is complete as far as one
          booking partner goes and not complete in any larger sense. A few of the best known places
          on the mountain are not bookable through it at all. Searching the whole area is sometimes
          faster than reading 809 names.
        </p>
        <p class="foot__links">
          <a class="vm-btn" href={storefrontUrl('Deqing')} rel="sponsored noopener" target="_blank">
            Search Deqing on Trip.com
            <span class="vm-sr-only"> (opens in a new tab)</span>
          </a>
          <a
            class="vm-btn vm-btn--ghost"
            href={storefrontUrl('Huzhou')}
            rel="sponsored noopener"
            target="_blank"
          >
            Search Huzhou
            <span class="vm-sr-only"> (opens in a new tab)</span>
          </a>
        </p>
        <p class="foot__disclosure">
          Every rates link on this page earns us a commission if you book through it, at no cost to
          you. It changes nothing about who is listed or in what order.{' '}
          <a href="/plan/disclosure">How this site is funded</a>.
        </p>
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Head ------------------------------------------------------------------ */

  .head {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .head h1 {
    max-width: 20ch;
    text-wrap: balance;
  }

  .standfirst {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
  }

  .caveat {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Jump index ------------------------------------------------------------- */

  .jump {
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--color-line);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    background: var(--color-mist);
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .jump a:hover,
  .jump a:focus-visible {
    background: var(--color-mist-muted);
  }

  /* Tabular figures so the counts line up down a wrapped row. */
  .jump__count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .jump__note {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Groups ----------------------------------------------------------------- */

  .group {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
    /* Clears the sticky header when a jump link lands here. */
    scroll-margin-top: 5.5rem;
  }

  .group h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .group__count {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .group__blurb {
    max-width: 58ch;
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Rows ------------------------------------------------------------------- */

  /* A ruled list rather than cards. 809 cards is a scroll nobody finishes, and
     the only three facts a row carries are a name, a county and a link. */
  .rows {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 7rem auto;
    }
  }

  .row__name {
    min-width: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    /* Long transliterated names run past any sensible column; wrapping beats
       an ellipsis that hides the half of the name you were looking for. */
    overflow-wrap: anywhere;
  }

  .row__name a {
    color: var(--color-bamboo);
    text-decoration: none;
  }

  .row__name a:hover,
  .row__name a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .row__flag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.4rem;
    background: var(--color-mist);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-leaf);
    white-space: nowrap;
  }

  .row__city {
    grid-column: 1;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .row__city {
      grid-column: auto;
    }
  }

  .row__cta {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-bamboo);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--color-line);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .row__cta {
      grid-column: auto;
      grid-row: auto;
    }
  }

  .row__cta:hover,
  .row__cta:focus-visible {
    background: var(--color-mist-50);
    box-shadow: inset 0 0 0 1px var(--color-bamboo);
  }

  /* Foot ------------------------------------------------------------------- */

  .foot {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .foot h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .foot p {
    max-width: 62ch;
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .foot__disclosure {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .foot__disclosure a {
    color: var(--color-bamboo);
  }
</style>
