---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StayTypeList from '../../../components/StayTypeList.astro';
import { CAPTURES } from '../../../lib/captures';
import {
  TYPE_LABEL,
  TYPE_SLUG,
  resolveStayHrefs,
  staysOfType,
  typeAllUrl,
  typePagesToGenerate,
  typePath,
  type StayType,
} from '../../../lib/stays';

/**
 * /where-to-stay/{type}/all
 *
 * Every property of one kind on a single page, for the reader who arrived with
 * a name in mind and wants the search box to cover all of them at once. It is
 * the page the paginated listing used to be, kept for that one job and taken
 * out of the index: the paginated first page is the one the crawler should
 * read, and two URLs carrying the same four hundred cards would compete with
 * each other for the same query.
 */
export async function getStaticPaths() {
  const types = await typePagesToGenerate();
  const writtenUp = await resolveStayHrefs();

  return types.map((type) => ({
    params: { type: TYPE_SLUG[type] },
    props: { type, writtenUp },
  }));
}

interface Props {
  type: StayType;
  writtenUp: Map<number, string>;
}

const { type, writtenUp } = Astro.props as Props;

const label = TYPE_LABEL[type];
const rows = [...staysOfType(type)].sort(
  (a, b) => (CAPTURES.get(b.id)?.rating?.count ?? 0) - (CAPTURES.get(a.id)?.rating?.count ?? 0),
);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Where to stay', href: '/where-to-stay' },
  { label, href: typePath(type) },
  { label: 'All on one page', href: typeAllUrl(type) },
];
---

<Layout
  title={`Moganshan ${label.toLowerCase()}: all ${rows.length} on one page · Visit Moganshan`}
  description={`Every one of the ${rows.length} ${label.toLowerCase()} bookable around Moganshan on a single page, searchable by name.`}
  noindex
  robots="noindex, follow"
>
  <SiteHeader />
  <Breadcrumbs crumbs={crumbs} />

  <main id="main">
    <StayTypeList type={type} writtenUp={writtenUp} rows={rows} total={rows.length} />
  </main>

  <SiteFooter />
</Layout>
