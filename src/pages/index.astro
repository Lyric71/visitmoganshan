---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import Hero from '../components/home/Hero.astro';
import HillStation from '../components/home/HillStation.astro';
import FourParts from '../components/home/FourParts.astro';
import ThingsToDo from '../components/home/ThingsToDo.astro';
import Journal from '../components/home/Journal.astro';
import Divider from '../components/home/Divider.astro';
import OrientationStrip from '../components/home/OrientationStrip.astro';
import WhereToStay from '../components/home/WhereToStay.astro';
import GettingHere from '../components/home/GettingHere.astro';
import Itineraries from '../components/home/Itineraries.astro';
import WhenToGo from '../components/home/WhenToGo.astro';
import BeforeYouCome from '../components/home/BeforeYouCome.astro';
import TradeStrip from '../components/home/TradeStrip.astro';
import PlanBar from '../components/home/PlanBar.astro';

import { websiteLd, placeLd } from '../lib/jsonld';

/**
 * The home page.
 *
 * Culture first, practical second, hinged on the Divider band. Fourteen
 * sections, and the order is load bearing: the destination has almost no
 * international search demand of its own, so the top half has to make somebody
 * want to come and the bottom half has to answer every practical question
 * without making them leave.
 *
 * Exactly one h1 on the page, and it is the single word "Moganshan".
 */
const jsonLd = [websiteLd, placeLd]
  .map((block) => `<script type="application/ld+json">${JSON.stringify(block)}</script>`)
  .join('\n');
---

<Layout
  title="Moganshan, China: the complete guide | Visit Moganshan"
  description="An independent guide to Moganshan: the hill station above Shanghai, where to stay, how to get there from Shanghai and Hangzhou, and when to go."
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={jsonLd} />
  </Fragment>

  <SiteHeader />

  <main id="main">
    {/* Culture */}
    <Hero />
    <HillStation />
    <FourParts />
    <ThingsToDo />
    <Journal />

    {/* The hinge */}
    <Divider />

    {/* Practical */}
    <OrientationStrip />
    <WhereToStay />
    <GettingHere />
    <Itineraries />
    <WhenToGo />
    <BeforeYouCome />
    <TradeStrip />
  </main>

  <SiteFooter />
  <PlanBar />
</Layout>
