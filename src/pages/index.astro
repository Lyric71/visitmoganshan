---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import Hero from '../components/home/Hero.astro';
import FourParts from '../components/home/FourParts.astro';
import ThingsToDo from '../components/home/ThingsToDo.astro';
import Journal from '../components/home/Journal.astro';
import WhereToStay from '../components/home/WhereToStay.astro';
import GettingHere from '../components/home/GettingHere.astro';
import PlacesToVisit from '../components/home/PlacesToVisit.astro';
import Itineraries from '../components/home/Itineraries.astro';
import WhenToGo from '../components/home/WhenToGo.astro';
import BeforeYouCome from '../components/home/BeforeYouCome.astro';
import PlanBar from '../components/home/PlanBar.astro';

import { websiteLd, placeLd } from '../lib/jsonld';

/**
 * The home page.
 *
 * Culture first, practical second, hinged on the orientation strip. The order
 * is load bearing: the destination has almost no international search demand of
 * its own, so the top half has to make somebody want to come and the bottom
 * half has to answer every practical question without making them leave.
 *
 * The journal sits at the end rather than in the culture half. It is the one
 * block on the page nobody arrives needing, so it reads better as what is left
 * to browse once every practical question has been answered.
 *
 * The ten places slider sits below Getting here rather than above the divider.
 * A reader who has just read how to arrive is choosing what to do with the
 * day, and that is the question the slider answers.
 *
 * Exactly one h1 on the page, and it is the single word "Moganshan".
 */
const jsonLd = [websiteLd, placeLd]
  .map((block) => `<script type="application/ld+json">${JSON.stringify(block)}</script>`)
  .join('\n');
---

<Layout
  title="Moganshan, China: the complete guide | Visit Moganshan"
  description="An independent guide to Moganshan: the hill station above Shanghai, where to stay, how to get there from Shanghai and Hangzhou, and when to go."
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={jsonLd} />
  </Fragment>

  <SiteHeader />

  <main id="main">
    {/* Culture */}
    <Hero />
    <FourParts />
    <ThingsToDo />

    {/* Practical. Where to stay is the hinge, and carries #plan. */}
    <WhereToStay />
    <GettingHere />
    <PlacesToVisit />
    <Itineraries />
    <WhenToGo />
    <BeforeYouCome />

    {/* The journal closes the page: reading, once the planning is answered. */}
    <Journal />

    {/* The trade strip is pulled for now. The component is still in
        src/components/home/TradeStrip.astro, and /trade is still linked from
        the footer. */}
  </main>

  <SiteFooter />
  <PlanBar />
</Layout>
