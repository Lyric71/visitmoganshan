---
import AdminPage from '../../layouts/AdminPage.astro';
import { isConfigured, isSignedIn } from '../../lib/admin-auth';
import { createAdminCaptcha } from '../../lib/admin-captcha';

/**
 * /admin/login
 *
 * One form, posting to /api/admin/login. The browser submits it, the server
 * answers with a redirect, and the cookie the response sets is HttpOnly so
 * nothing in the page can read it. The only client JavaScript is the show or
 * hide toggle on the password field, which flips the input type and nothing
 * else; without it the form still works, the toggle just stays hidden.
 *
 * The picture puzzle is drawn fresh on every render of this page, server side,
 * and posted back with a signed token. See src/lib/admin-captcha.ts for what it
 * is and is not.
 *
 * Somebody already signed in is sent on rather than shown a form they do not
 * need.
 */
export const prerender = false;

if (isSignedIn(Astro.cookies)) return Astro.redirect('/admin');

const params = Astro.url.searchParams;
const error = params.get('error');
const unconfigured = error === 'unconfigured' || !isConfigured();
const signedOut = params.has('signed-out');

const MESSAGES: Record<string, string> = {
  captcha: 'The characters in the picture were not right. Here is a new picture.',
  expired: 'That picture timed out. Here is a new one.',
};
const failure = error ? (MESSAGES[error] ?? 'Those details are not right.') : null;

const captcha = unconfigured ? null : createAdminCaptcha();
---

<AdminPage title="Sign in" showNav={false}>
  {
    signedOut && (
      <p class="msg msg--quiet" role="status">
        Signed out.
      </p>
    )
  }

  {
    unconfigured ? (
      <div class="msg msg--warn" role="alert">
        <p>
          <strong>The admin is not configured on this deployment.</strong>
        </p>
        <p>
          It needs <code>ADMIN_EMAIL</code>, <code>ADMIN_PASSWORD_HASH</code> and{' '}
          <code>ADMIN_SECRET</code> in the environment. Generate the last two with{' '}
          <code>npm run admin:hash -- 'your password'</code> and put them in{' '}
          <code>.env.local</code> for local work and in the Vercel project settings for the
          deployed site. Until all three are set, every sign in is refused.
        </p>
      </div>
    ) : (
      <>
        {failure && (
          <p class="msg msg--error" role="alert">
            {failure}
          </p>
        )}

        <form class="form" method="post" action="/api/admin/login">
          <p class="field">
            <label for="email">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              autofocus
            />
          </p>

          <p class="field">
            <label for="password">Password</label>
            <span class="password">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
              />
              <button
                class="password__toggle"
                type="button"
                aria-controls="password"
                aria-pressed="false"
                hidden
              >
                Show
              </button>
            </span>
          </p>

          <div class="field captcha">
            <label for="captcha">Type the characters in the picture</label>
            <img
              class="captcha__image"
              src={captcha!.image}
              width="320"
              height="104"
              alt="Six letters and digits drawn in a warped hand, for you to type"
            />
            <input
              id="captcha"
              name="captcha"
              type="text"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              maxlength="8"
              required
            />
            <input type="hidden" name="captcha-token" value={captcha!.token} />
            <p class="captcha__hint">
              Case does not matter. <a href="/admin/login">Show a different picture</a>
            </p>
          </div>

          <p>
            <button class="vm-btn" type="submit">
              Sign in
            </button>
          </p>
        </form>
      </>
    )
  }
</AdminPage>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.password__toggle');
  const input = document.getElementById('password') as HTMLInputElement | null;
  if (toggle && input) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.textContent = show ? 'Hide' : 'Show';
      toggle.setAttribute('aria-pressed', String(show));
      input.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .form {
    max-width: 24rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .field {
    margin: 0 0 1rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .field input {
    width: 100%;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-surface);
    font: inherit;
    font-size: 0.9375rem;
  }

  .field input:focus-visible {
    border-color: var(--color-bamboo);
  }

  .password {
    position: relative;
    display: block;
  }

  .password input {
    padding-right: 4rem;
  }

  .password__toggle {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    transform: translateY(-50%);
    min-height: 32px;
    padding: 0 0.6rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .password__toggle:hover,
  .password__toggle:focus-visible {
    color: var(--color-ink);
    background: var(--color-mist);
  }

  .captcha__image {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
    margin-bottom: 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    user-select: none;
  }

  .captcha__hint {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .msg {
    max-width: 42rem;
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .msg p {
    margin: 0;
  }

  .msg p + p {
    margin-top: 0.6rem;
  }

  .msg--error {
    border-left: 2px solid #a03232;
    background: var(--color-paper);
  }

  .msg--warn {
    border-left: 2px solid var(--color-amber);
    background: var(--color-paper);
  }

  .msg--quiet {
    color: var(--color-muted);
  }

  code {
    font-size: 0.875em;
    background: var(--color-mist);
    padding: 0.1em 0.3em;
  }
</style>
