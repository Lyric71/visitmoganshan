---
import AdminPage from '../../layouts/AdminPage.astro';
import { isSignedIn } from '../../lib/admin-auth';
import { CAPTURES } from '../../lib/captures';
import { STAYS_SEED, TYPE_LABEL, TYPE_ORDER, guessType, typePath } from '../../lib/stays';

/**
 * /admin
 *
 * What state the property data is in, and what to run to move it on. It reads
 * and it does not write: the capture is a long job against a third party and
 * belongs on a machine with a browser and a couple of hours, not inside a
 * serverless request with a ten second budget. The page says which command to
 * run rather than pretending it can run it.
 */
export const prerender = false;

if (!isSignedIn(Astro.cookies)) return Astro.redirect('/admin/login');

const captured = STAYS_SEED.filter((row) => CAPTURES.has(row.id));
const missing = STAYS_SEED.length - captured.length;

const withImages = captured.filter((row) => (CAPTURES.get(row.id)?.images.length ?? 0) >= 1).length;
const withComments = captured.filter(
  (row) => (CAPTURES.get(row.id)?.comments.length ?? 0) >= 1,
).length;
const withSummary = captured.filter(
  (row) => (CAPTURES.get(row.id)?.summary?.topics.length ?? 0) > 0,
).length;

const dates = captured
  .map((row) => CAPTURES.get(row.id)?.sourcedAt)
  .filter((date): date is string => Boolean(date))
  .sort();
const oldest = dates[0];
const newest = dates[dates.length - 1];

const byType = TYPE_ORDER.map((type) => {
  const rows = STAYS_SEED.filter((row) => guessType(row.name) === type);
  return {
    type,
    label: TYPE_LABEL[type],
    href: typePath(type),
    total: rows.length,
    captured: rows.filter((row) => CAPTURES.has(row.id)).length,
  };
});

const pct = (part: number, whole: number) => (whole ? Math.round((part / whole) * 100) : 0);
const day = (iso?: string) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : 'never';
---

<AdminPage title="Overview">
  <section class="stats" aria-label="Property data at a glance">
    <div class="stat">
      <p class="stat__num">{STAYS_SEED.length.toLocaleString('en-GB')}</p>
      <p class="stat__label">properties in the affiliate list</p>
    </div>
    <div class="stat">
      <p class="stat__num">{captured.length.toLocaleString('en-GB')}</p>
      <p class="stat__label">with a capture ({pct(captured.length, STAYS_SEED.length)} percent)</p>
    </div>
    <div class="stat">
      <p class="stat__num">{missing.toLocaleString('en-GB')}</p>
      <p class="stat__label">still showing a bare card</p>
    </div>
    <div class="stat">
      <p class="stat__num">{day(newest)}</p>
      <p class="stat__label">most recent capture</p>
    </div>
  </section>

  <section class="panel" aria-labelledby="coverage">
    <h2 id="coverage">Coverage</h2>
    <table>
      <thead>
        <tr>
          <th scope="col">Kind</th>
          <th scope="col" class="num">In list</th>
          <th scope="col" class="num">Captured</th>
          <th scope="col" class="num">Percent</th>
        </tr>
      </thead>
      <tbody>
        {
          byType.map((row) => (
            <tr>
              <th scope="row">
                <a href={row.href}>{row.label}</a>
              </th>
              <td class="num">{row.total}</td>
              <td class="num">{row.captured}</td>
              <td class="num">{pct(row.captured, row.total)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="panel" aria-labelledby="quality">
    <h2 id="quality">What the captures carry</h2>
    <ul class="facts">
      <li>
        <strong>{withImages.toLocaleString('en-GB')}</strong> have at least one photograph
      </li>
      <li>
        <strong>{withComments.toLocaleString('en-GB')}</strong> have at least one guest excerpt
      </li>
      <li>
        <strong>{withSummary.toLocaleString('en-GB')}</strong> have a Trip.com review summary to
        show as the card description
      </li>
      <li>Oldest capture on file: <strong>{day(oldest)}</strong></li>
    </ul>
  </section>

  <section class="panel" aria-labelledby="jobs">
    <h2 id="jobs">Running the jobs</h2>
    <p class="panel__note">
      These run on a machine with a browser, not here. A capture pass takes a couple of hours at two
      requests at a time, which is the polite rate and not negotiable, and a serverless request has
      about ten seconds.
    </p>
    <dl class="jobs">
      <dt><code>npm run stays:discover</code></dt>
      <dd>
        Walk the Trip.com listings for Deqing and Huzhou and add any property that is not in the
        affiliate list yet. Adds only; never edits or removes an existing row.
      </dd>

      <dt><code>npm run stays:collect</code></dt>
      <dd>
        Fetch photographs, the review summary and guest excerpts for every property with no capture
        yet. Resumable, cached, skips what it already has.
      </dd>

      <dt><code>npm run stays:img</code></dt>
      <dd>Re-encode every captured image to the size budget. Run after any capture pass.</dd>

      <dt><code>npm run stays:validate</code></dt>
      <dd>Check the seed, the redirect table and every written-up entry. Run before a deploy.</dd>
    </dl>
    <p class="panel__note">
      Or ask Claude Code to run the <strong>stays-updater</strong> agent, which does the discover
      pass, the capture and the re-encode in order and reports what changed.
    </p>
  </section>
</AdminPage>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin-bottom: 2rem;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .stat {
    padding: 1rem 1.25rem;
    background: var(--color-paper);
  }

  .stat__num {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--color-bamboo);
  }

  .stat__label {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-muted);
  }

  .panel {
    margin-bottom: 2rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--color-paper);
    border: 1px solid var(--color-line);
  }

  .panel h2 {
    margin: 0 0 1rem;
    font-size: 1.125rem;
  }

  .panel__note {
    max-width: 62ch;
    margin: 0 0 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }

  thead th {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  tbody th {
    font-weight: 400;
  }

  .facts {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .jobs {
    margin: 0;
  }

  .jobs dt {
    margin-top: 0.9rem;
  }

  .jobs dd {
    margin: 0.2rem 0 0;
    max-width: 68ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  code {
    font-size: 0.875em;
    background: var(--color-mist);
    padding: 0.15em 0.4em;
  }
</style>
