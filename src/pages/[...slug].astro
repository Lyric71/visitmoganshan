---
import { render } from 'astro:content';
import GuideArticle from '../layouts/GuideArticle.astro';
import { getGuideEntries, toSlug } from '../lib/guide';
import { getPublishedStays } from '../lib/stays';

/**
 * Every guide page.
 *
 * The route comes from the frontmatter `url`, not from the filename, so a
 * writer can move a page in the tree by editing one line and the source
 * directory stays flat and greppable. The home page keeps its own
 * src/pages/index.astro; this catch-all never matches it.
 */
export async function getStaticPaths() {
  const all = await getGuideEntries();
  // An article about one bookable property absorbs that property's gallery,
  // guest excerpts and booking link, so the hotel has one page rather than two
  // competing for its own name. See getRoutableStays in src/lib/stays.ts.
  const stays = await getPublishedStays();

  return all.map((entry) => ({
    params: { slug: toSlug(entry.data.url) },
    props: {
      entry,
      all,
      stay: stays.find((candidate) => candidate.data.id === entry.data.stay_id) ?? null,
    },
  }));
}

const { entry, all, stay } = Astro.props;
const { Content, headings } = await render(entry);
---

<GuideArticle entry={entry} all={all} headings={headings} stay={stay}>
  <Content />
</GuideArticle>
