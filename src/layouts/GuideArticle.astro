---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { NAV, isCurrentGroup } from '../data/nav';
import {
  breadcrumbsFor,
  guideJsonLd,
  readingMinutes,
  sectionLabel,
  siblingsOf,
  toPath,
  type GuideEntry,
} from '../lib/guide';

/**
 * The shell every guide page renders into.
 *
 * One h1, from frontmatter; the markdown body supplies h2s and below. A
 * horizontal contents strip sits above the body at every width, because these
 * pages run 1,300 to 2,100 words and a reader who arrived from a logistics
 * search wants one section, not the essay. The measure stays with the prose:
 * the strip runs the full container, the article holds its 68ch column.
 *
 * Everything below the body is internal linking. Deep pages arriving from
 * search are the entire traffic model, so each one ends with a way sideways
 * rather than a dead stop.
 */
interface Props {
  entry: GuideEntry;
  all: GuideEntry[];
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, all, headings } = Astro.props;
const { data } = entry;

const path = toPath(data.url);
const crumbs = breadcrumbsFor(data.url, all);
const kicker = sectionLabel(data.url);
const minutes = readingMinutes(data.word_count);
const siblings = siblingsOf(entry, all);

// The FAQ hub for this page's mega-menu group. Articles carry no FAQ block of
// their own any more, so every one of them has to hand the reader on to the
// page where the questions for its section are answered. Suppressed on the hub
// itself, which would otherwise link to where the reader already is.
const faqLink = NAV.find((group) => isCurrentGroup(group, path))?.faq;
const showFaqLink = faqLink && faqLink.href !== path;

// Contents rail: h2s only. h3s exist on a few pages and listing them turns the
// rail into a second table of contents for itself.
const sections = headings.filter((heading) => heading.depth === 2);

const jsonLd = guideJsonLd(entry, crumbs)
  .map((block) => `<script type="application/ld+json">${JSON.stringify(block)}</script>`)
  .join('\n');
---

<Layout title={data.seo_title} description={data.meta_description}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={jsonLd} />
  </Fragment>

  <SiteHeader />
  <Breadcrumbs crumbs={crumbs} />

  <main id="main">
    <div class="vm-container">
      <header class="head">
        {kicker && <p class="vm-kicker">{kicker}</p>}
        <h1>{data.title}</h1>
        <p class="standfirst">{data.excerpt}</p>
        {
          minutes && (
            <p class="byline">
              <span>{minutes} min read</span>
            </p>
          )
        }
      </header>

      {
        data.image && (
          <figure class="lead">
            {/* Eager, and fetchpriority high: this is the LCP element on every
                page that has one, and letting the browser discover it lazily
                costs a round trip it cannot get back. */}
            <img
              src={data.image}
              alt={data.image_alt ?? ''}
              width="1600"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="body">
        {
          sections.length > 2 && (
            <nav class="toc" aria-labelledby="toc-title">
              <p class="vm-kicker" id="toc-title">
                On this page
              </p>
              {/* role="list" restores the semantics Safari drops from a
                  list-style: none list. */}
              <ol role="list">
                {sections.map((section, index) => (
                  <li>
                    <a href={`#${section.slug}`}>
                      <span class="toc__num" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <span class="toc__text">{section.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <article class="vm-article">
          <slot />

          {/* Every photograph on this page is generated, and several of them
              stand in for places a reader could go and identify: a named villa
              on the walking tour, a named hotel, the station. A reader who
              takes one of those for a photograph of the actual building has
              been misled, and on a site that marks its unverified figures that
              is not a footnote. It sits at the end of the prose, before the
              onward links, on every article rather than only the ones with a
              named subject: a note that appears sometimes is a note nobody
              learns to look for. */}
          <p class="illustration-note">
            Photographs on this site are representative illustrations, not documentary images of
            the specific building, property or service described.
          </p>

          {
            showFaqLink && (
              <aside class="faq">
                <p class="vm-kicker">Still have a question?</p>
                <p>
                  <a href={faqLink.href}>{faqLink.label}</a>
                </p>
                <p class="faq__sub">
                  The questions readers ask across every page in this section, answered together.
                </p>
              </aside>
            )
          }
        </article>
      </div>

      {
        siblings.length > 0 && (
          <section class="more" aria-labelledby="more-title">
            <h2 id="more-title">More in {kicker ?? 'this section'}</h2>
            <ul>
              {siblings.map((sibling) => (
                <li>
                  <a href={toPath(sibling.data.url)}>
                    <span class="more__media">
                      {sibling.data.image && (
                        <img
                          src={sibling.data.image}
                          alt={sibling.data.image_alt ?? ''}
                          width="300"
                          height="200"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </span>
                    <span class="more__text">
                      <span class="more__title">{sibling.data.title}</span>
                      <span class="more__sub">{sibling.data.excerpt}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Head ------------------------------------------------------------------ */

  /* The breadcrumb strip carries its own rule, so the top padding here is the
     gap below that rule, not the gap below the header. */
  .head {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .head h1 {
    max-width: 22ch;
    text-wrap: balance;
  }

  .standfirst {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* Lead image ------------------------------------------------------------ */

  /* Full container width, not the prose measure: the lead is the one image on
     the page that is establishing the place rather than illustrating a
     paragraph, and it earns the extra width. 16:9 rather than the 3:2 the body
     figures use, so it never pushes the first paragraph off a phone screen. */
  .lead {
    margin: 0;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .lead img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-mist);
  }

  /* Body ------------------------------------------------------------------ */

  /* min-width: 0 on the article rather than the wrapper: one wide timetable
     would otherwise stretch the body past the viewport instead of scrolling
     inside its own box. */
  .body {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  /* The contents strip and the prose now share one full-width column, so the
     68ch cap the article carries by default is lifted here. */
  .body > .vm-article {
    min-width: 0;
    max-width: none;
  }

  /* Contents index --------------------------------------------------------- */

  /* Wrapping a flat row of links produced ragged, uneven columns. A ruled grid
     instead: fixed tracks, one hairline per row, numbers running down the left
     of each entry, so the block reads as an index rather than a stray line of
     navigation that happened to wrap. */
  .toc {
    margin-bottom: clamp(2.25rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    background: var(--color-mist-50);
  }

  .toc ol {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .toc ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .toc li {
    border-top: 1px solid var(--color-line);
  }

  .toc li a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    /* Padding, not a line-height fudge: the row has to clear 44px for a thumb
       even though the type is 14px. */
    padding: 0.7rem 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  /* Tabular figures keep 01 and 11 the same width, so the titles start on one
     line down every column. */
  .toc__num {
    flex: none;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--color-leaf);
  }

  .toc li a:hover {
    color: var(--color-bamboo);
  }

  .toc li a:hover .toc__text {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* Illustration disclosure ------------------------------------------------ */

  /* Quiet, but not hidden: same treatment as the source notes the prose already
     uses for a figure it cannot stand behind, which is exactly what this is. */
  .illustration-note {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* FAQ hub pointer -------------------------------------------------------- */

  .faq {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--color-leaf);
    background: var(--color-mist-50);
  }

  .faq p {
    margin: 0;
  }

  .faq p + p {
    margin-top: 0.35rem;
  }

  .faq a {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--color-bamboo);
    text-decoration: none;
  }

  .faq a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq__sub {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* More in this section --------------------------------------------------- */

  .more {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-line);
  }

  .more h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    margin-bottom: 1.5rem;
  }

  .more ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border-block: 1px solid var(--color-line);
  }

  @media (min-width: 768px) {
    .more ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .more li a {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    height: 100%;
    padding: 1.125rem 1.25rem;
    background: var(--color-paper);
    text-decoration: none;
  }

  .more li a:hover {
    background: var(--color-mist-50);
  }

  /* Fixed basis rather than a percentage: the two columns are different
     widths at some viewports, and a thumbnail that changes size between them
     reads as two different components. */
  .more__media {
    flex: 0 0 5.5rem;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-mist);
  }

  .more__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .more li a:hover .more__media img {
    opacity: 0.92;
  }

  .more__text {
    min-width: 0;
  }

  .more__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--color-bamboo);
  }

  .more__sub {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
