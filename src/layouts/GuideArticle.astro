---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  breadcrumbsFor,
  formatDate,
  guideJsonLd,
  readingMinutes,
  sectionLabel,
  siblingsOf,
  toPath,
  type GuideEntry,
} from '../lib/guide';

/**
 * The shell every guide page renders into.
 *
 * One h1, from frontmatter; the markdown body supplies h2s and below. The
 * layout is single-column on mobile and gains a sticky contents rail at
 * 1024px, because these pages run 1,300 to 2,100 words and a reader who
 * arrived from a logistics search wants one section, not the essay.
 *
 * Everything below the body is internal linking. Deep pages arriving from
 * search are the entire traffic model, so each one ends with a way sideways
 * rather than a dead stop.
 */
interface Props {
  entry: GuideEntry;
  all: GuideEntry[];
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, all, headings } = Astro.props;
const { data } = entry;

const crumbs = breadcrumbsFor(data.url, all);
const kicker = sectionLabel(data.url);
const minutes = readingMinutes(data.word_count);
const siblings = siblingsOf(entry, all);

// Contents rail: h2s only. h3s exist on a few pages and listing them turns the
// rail into a second table of contents for itself.
const sections = headings.filter((heading) => heading.depth === 2);

const jsonLd = guideJsonLd(entry, crumbs)
  .map((block) => `<script type="application/ld+json">${JSON.stringify(block)}</script>`)
  .join('\n');
---

<Layout title={data.seo_title} description={data.meta_description}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={jsonLd} />
  </Fragment>

  <SiteHeader />

  <main id="main">
    <div class="vm-container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {
            crumbs.map((crumb, i) => (
              <li>
                {i === crumbs.length - 1 ? (
                  <span aria-current="page">{crumb.label}</span>
                ) : (
                  <a href={crumb.href}>{crumb.label}</a>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <header class="head">
        {kicker && <p class="vm-kicker">{kicker}</p>}
        <h1>{data.title}</h1>
        <p class="standfirst">{data.excerpt}</p>
        <p class="byline">
          <span
            >Last updated <time datetime={data.last_updated.toISOString().slice(0, 10)}
              >{formatDate(data.last_updated)}</time
            ></span
          >
          {minutes && <span>{minutes} min read</span>}
        </p>
      </header>

      <div class="grid">
        {
          sections.length > 2 && (
            <aside class="toc" aria-labelledby="toc-title">
              <p class="vm-kicker" id="toc-title">
                On this page
              </p>
              <ul>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <article class="vm-article">
          <slot />
        </article>
      </div>

      {
        siblings.length > 0 && (
          <section class="more" aria-labelledby="more-title">
            <h2 id="more-title">More in {kicker ?? 'this section'}</h2>
            <ul>
              {siblings.map((sibling) => (
                <li>
                  <a href={toPath(sibling.data.url)}>
                    <span class="more__title">{sibling.data.title}</span>
                    <span class="more__sub">{sibling.data.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Breadcrumb ------------------------------------------------------------ */

  .crumbs {
    padding-block: 1.25rem 0;
    font-size: 0.8125rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--color-line);
  }

  .crumbs a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-bamboo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumbs [aria-current='page'] {
    color: var(--color-ink);
  }

  /* Head ------------------------------------------------------------------ */

  .head {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .head h1 {
    max-width: 22ch;
    text-wrap: balance;
  }

  .standfirst {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* Body ------------------------------------------------------------------ */

  .grid {
    display: grid;
    /* minmax(0, 1fr) rather than 1fr: a grid item's default min-width is auto,
       so one wide timetable would otherwise stretch the whole column past the
       viewport instead of scrolling inside its own box. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
    }

    /* Contents first in the source order would put a nav between the h1 and the
       first paragraph for a screen reader. It is placed second and pulled left
       instead, so the reading order stays heading, then article. */
    .toc {
      position: sticky;
      top: 5.5rem;
      order: -1;
    }
  }

  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-line);
  }

  .toc li a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.875rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-muted);
    text-decoration: none;
  }

  .toc li a:hover {
    border-left-color: var(--color-leaf);
    color: var(--color-bamboo);
  }

  /* More in this section --------------------------------------------------- */

  .more {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-line);
  }

  .more h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    margin-bottom: 1.5rem;
  }

  .more ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border-block: 1px solid var(--color-line);
  }

  @media (min-width: 768px) {
    .more ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .more li a {
    display: block;
    height: 100%;
    padding: 1.125rem 1.25rem;
    background: var(--color-paper);
    text-decoration: none;
  }

  .more li a:hover {
    background: var(--color-mist-50);
  }

  .more__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--color-bamboo);
  }

  .more__sub {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
