---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import ContentsBar from '../components/ContentsBar.astro';
import Card from '../components/Card.astro';
import StayBooking from '../components/StayBooking.astro';
import type { StayEntry } from '../lib/stays';
import { NAV, isCurrentGroup } from '../data/nav';
import { authorById, authorPath, type AuthorId } from '../data/authors';
import {
  breadcrumbsFor,
  formatDate,
  guideJsonLd,
  readingMinutes,
  sectionLabel,
  siblingsOf,
  toPath,
  type GuideEntry,
} from '../lib/guide';

/**
 * The shell every guide page renders into.
 *
 * One h1, from frontmatter; the markdown body supplies h2s and below. The
 * page opens the way the home page does (Cyril, 7 September 2026: every page
 * in the magazine language): the lead photograph runs full width with the
 * title, standfirst and byline set on it, and a sticky contents bar under it
 * follows the reader through the h2s. These pages run 1,300 to 2,100 words
 * and a reader who arrived from a logistics search wants one section, not
 * the essay, so the bar stays with them the whole way down.
 *
 * Everything below the body is internal linking. Deep pages arriving from
 * search are the entire traffic model, so each one ends with a way sideways
 * rather than a dead stop.
 */
interface Props {
  entry: GuideEntry;
  all: GuideEntry[];
  headings: { depth: number; slug: string; text: string }[];
  /** Set on the handful of articles that are about one bookable property. */
  stay?: StayEntry | null;
}

const { entry, all, headings, stay = null } = Astro.props;
const { data } = entry;

const path = toPath(data.url);
const crumbs = breadcrumbsFor(data.url, all);
const kicker = sectionLabel(data.url);
const minutes = readingMinutes(data.word_count);
const siblings = siblingsOf(entry, all);

// The byline. A named person, linked to the About page where the name
// resolves to a role and a public profile, then the two dates. "Updated" only
// appears once the page has moved since it was published: printing two equal
// dates says nothing and looks like a template.
const author = authorById(data.author as AuthorId);
const publishedOn = formatDate(data.published);
const updatedOn = formatDate(data.last_updated);
const wasUpdated = data.last_updated.getTime() > data.published.getTime();

// The FAQ hub for this page's mega-menu group. Articles carry no FAQ block of
// their own any more, so every one of them has to hand the reader on to the
// page where the questions for its section are answered. Suppressed on the hub
// itself, which would otherwise link to where the reader already is.
const faqLink = NAV.find((group) => isCurrentGroup(group, path))?.faq;
const showFaqLink = faqLink && faqLink.href !== path;

// Contents rail: h2s only. h3s exist on a few pages and listing them turns the
// rail into a second table of contents for itself.
const sections = headings.filter((heading) => heading.depth === 2);

const jsonLd = guideJsonLd(entry, crumbs)
  .map((block) => `<script type="application/ld+json">${JSON.stringify(block)}</script>`)
  .join('\n');
---

<Layout title={data.seo_title} description={data.meta_description}>
  <Fragment slot="head">
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <Fragment set:html={jsonLd} />
  </Fragment>

  <SiteHeader />
  <Breadcrumbs crumbs={crumbs} />

  <main id="main">
    <PageHero
      title={data.title}
      kicker={kicker}
      standfirst={data.excerpt}
      image={data.image}
      imageAlt={data.image_alt}
    >
      <p class="opening__byline">
        <span>
          By <a href={authorPath(author)} rel="author">{author.name}</a>
        </span>
        <span>
          Published <time datetime={data.published.toISOString().slice(0, 10)}>{publishedOn}</time>
        </span>
        {
          wasUpdated && (
            <span>
              Updated <time datetime={data.last_updated.toISOString().slice(0, 10)}>{updatedOn}</time>
            </span>
          )
        }
        {minutes && <span>{minutes} min read</span>}
      </p>
    </PageHero>

    {
      sections.length > 2 && (
        <ContentsBar items={sections.map((section) => ({ id: section.slug, label: section.text }))} />
      )
    }

    <div class="vm-container">
      <div class="body">
        <article class="vm-article">
          <slot />

          {/* Every photograph on this page is generated, and several of them
              stand in for places a reader could go and identify: a named villa
              on the walking tour, a named hotel, the station. A reader who
              takes one of those for a photograph of the actual building has
              been misled, and on a site that marks its unverified figures that
              is not a footnote. It sits at the end of the prose, before the
              onward links, on every article rather than only the ones with a
              named subject: a note that appears sometimes is a note nobody
              learns to look for. */}
          {/* The freshness line, generated from last_updated rather than typed
              into the body. The articles used to end with a hand written
              "Checked 5 August 2026" paragraph, which meant the page carried
              two dates that could disagree, and did. One field, printed twice,
              cannot. Figures that were checked on a different day still say so
              inline, where the figure is. */}
          <p class="checked-note">
            Last checked {updatedOn} by {author.name}. Prices, timetables and entry rules on this
            mountain move without notice, so confirm anything you are booking around.
          </p>

          <p class="illustration-note">
            {
              stay
                ? 'The photographs above are representative illustrations, not documentary images of the specific building, property or service described. The gallery below is different: those frames are the property’s own listing images.'
                : 'Photographs on this site are representative illustrations, not documentary images of the specific building, property or service described.'
            }
          </p>

          {stay && <StayBooking entry={stay} />}

          {
            showFaqLink && (
              <aside class="faq" data-reveal>
                <p class="faq__kicker">Still have a question?</p>
                <p>
                  <a href={faqLink.href}>{faqLink.label}</a>
                </p>
                <p class="faq__sub">
                  The questions readers ask across every page in this section, answered together.
                </p>
              </aside>
            )
          }
        </article>
      </div>

      {
        siblings.length > 0 && (
          <section class="more" aria-labelledby="more-title">
            <div class="more__head" data-reveal>
              <h2 id="more-title">More in {kicker ?? 'this section'}</h2>
            </div>
            <ul class="more__grid">
              {siblings.map((sibling, i) => (
                <li style={`--i:${i % 4}`} data-reveal>
                  <Card
                    title={sibling.data.title}
                    sub={sibling.data.excerpt}
                    href={toPath(sibling.data.url)}
                    image={sibling.data.image}
                    alt={sibling.data.image_alt ?? ''}
                  />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Body ------------------------------------------------------------------ */

  /* min-width: 0 on the article rather than the wrapper: one wide timetable
     would otherwise stretch the body past the viewport instead of scrolling
     inside its own box. */
  .body {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  /* The prose runs the full container: the contents bar and the article now
     share one column, so the 68ch cap the article carries by default is
     lifted here. */
  .body > .vm-article {
    min-width: 0;
    max-width: none;
  }

  /* Notes ---------------------------------------------------------------- */

  /* Quiet, but not hidden: same treatment as the source notes the prose already
     uses for a figure it cannot stand behind, which is exactly what this is. */
  .checked-note {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .illustration-note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* FAQ hub pointer -------------------------------------------------------- */

  /* The same dark panel the home page uses for the month and the news. */
  .faq {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1.5rem 1.75rem;
    border-radius: 14px;
    background: var(--color-bamboo);
    color: var(--color-mist);
  }

  .faq p {
    margin: 0;
  }

  .faq p + p {
    margin-top: 0.35rem;
  }

  .faq__kicker {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .faq a {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    color: #fff;
    text-decoration: none;
  }

  .faq a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .faq__sub {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-mist-muted);
  }

  /* More in this section --------------------------------------------------- */

  .more {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-line);
  }

  .more h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.01em;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* Steps 1 -> 2 -> 4 with the home page's card. A section has between two
     and twelve siblings; four across is the widest that keeps a title on one
     or two lines. */
  .more__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .more__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .more__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
