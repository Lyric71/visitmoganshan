---
import {
  CAPTURES,
  cardComment,
  cardDescription,
  cardPrice,
  priceBand,
  usdAmount,
} from '../lib/captures';
import { goPath, type SeedRecord } from '../lib/stays';

/**
 * One property in a listing.
 *
 * Photographs, the score, the nightly rate, Trip.com's summary of what guests
 * keep saying, and one excerpt in a guest's own words. All of it captured from
 * Trip.com, because none of it is ours: we have not stayed at these places and
 * the card never implies otherwise.
 *
 * The name, the photographs and the button all go to the same place, the rates
 * page. Where a property has a page of ours as well, it is reached through the
 * small link in the meta line rather than through the name.
 *
 * A property with no capture yet still gets a card, with the name, the county
 * and the rates link. A skeleton that says what is missing is honest; a card
 * padded out with invented copy is not.
 */
interface Props {
  row: SeedRecord;
  /** Our own page for this property, when it has one. */
  href?: string;
}

const { row, href } = Astro.props;

const capture = CAPTURES.get(row.id);
const images = capture?.images.slice(0, 3) ?? [];
const blocks = capture ? cardDescription(capture) : [];
const comment = capture ? cardComment(capture) : null;
const rating = capture?.rating;
const price = cardPrice(capture);

// The filter bar above the list reads these off the card and hides the ones
// that do not match. They are written even when the value is missing, because
// "unknown" is a state the filter has to be able to see rather than a gap.
const usd = usdAmount(capture);
const filterData = {
  'data-price-band': priceBand(capture),
  'data-reviews': rating?.count ?? 0,
  // The name as written, for the search box. Read from an attribute rather than
  // from the heading because the heading is uppercased in CSS and carries a
  // screen reader suffix, neither of which anybody types.
  'data-name': row.name,
  // The rate as a number, for sorting. Absent rather than zero on a property
  // with no captured rate, so a cheapest-first sort cannot float it to the top
  // on a price it never quoted.
  ...(usd === null ? {} : { 'data-price': Math.round(usd) }),
};

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<article class="card" data-media={images.length > 0 ? 'yes' : 'no'} {...filterData}>
  <div class="card__aside">
    {
      images.length > 0 && (
      /* The photographs are the link too. They are the property's own listing
         images and a reader who clicks one is asking to see the property, which
         is what the rates page is. aria-label rather than letting the three alt
         texts become the link name: "X listing photograph 1 of 3 X listing
         photograph 2 of 3..." is not a name anybody wants read out. */
      <a
        class="card__media"
        data-count={images.length}
        href={goPath(row.goSlug)}
        rel="sponsored noopener"
        target="_blank"
        aria-label={`Photographs and rates for ${row.name} on Trip.com, opens in a new tab`}
      >
        {images.map((image, index) => (
          <img
            src={image.src}
            alt={`${row.name}, listing photograph ${index + 1} of ${images.length}`}
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
          />
        ))}
        </a>
      )
    }

    {/* The button sits with the photographs rather than at the foot of the
        prose. It goes to the same place they do, and a reader who has decided
        on a property from the frames should not have to scroll past two
        paragraphs of review summary to act on it. */}
    <p class="card__actions">
      <a
        class="card__cta"
        href={goPath(row.goSlug)}
        rel="sponsored noopener"
        target="_blank"
        aria-label={`Check dates for ${row.name} on Trip.com, opens in a new tab`}
      >
        Check dates
      </a>
    </p>
  </div>

  <div class="card__body">
    <header class="card__head">
      {/* The name goes to the rates page like the photographs do. Where we have
          written the property up, that page is reached through the flag below
          rather than through the name: a reader clicking a hotel's name in a
          listing is asking for the hotel, not for our essay about it. */}
      <h3>
        <a href={goPath(row.goSlug)} rel="sponsored noopener" target="_blank">
          {row.name}
          <span class="vm-sr-only"> on Trip.com, opens in a new tab</span>
        </a>
      </h3>
      <p class="card__meta">
        {row.city}
        {rating && (
          <>
            {' · '}
            <strong>
              {rating.score.toFixed(1)}/{rating.scale}
            </strong>{' '}
            from {rating.count.toLocaleString('en-GB')} reviews
          </>
        )}
        {href && (
          <>
            {' · '}
            <a class="card__flag" href={href}>
              Our write up
            </a>
          </>
        )}
      </p>
      {/* Trip.com's cheapest nightly rate at capture, not a quote. Rates move
          daily and this one is a snapshot of a single search, which is why the
          word is "from" and why the number is never presented as ours. */}
      {price && <p class="card__price">{price} <span class="card__price-unit">a night</span></p>}
    </header>

    {
      blocks.length > 0 && (
        <div class="card__desc">
          {blocks.map((block) => (
            <p>
              <span class="card__topic">{block.topic}</span>
              {block.text}
              <span class="card__basis"> Based on {block.count.toLocaleString('en-GB')} reviews.</span>
            </p>
          ))}
        </div>
      )
    }

    {
      comment && (
        <figure class="card__quote">
          <blockquote cite={comment.sourceUrl}>{comment.quote}</blockquote>
          {/* No translation note. Terms carries the standing line that nothing
              on a card is written by us and that the reviews are Trip.com's,
              and a label repeated under eight hundred quotes is noise. */}
          <figcaption>{comment.author}, {formatDate(comment.date)}</figcaption>
        </figure>
      )
    }

    {
      !capture && (
        <p class="card__pending">
          We have not gathered photographs or guest reviews for this one yet. The link goes straight
          to its listing.
        </p>
      )
    }

  </div>
</article>

<style>
  /* The filter bar hides a card with the hidden attribute. Without this the
     display:grid below wins over the user agent's [hidden] rule and a filtered
     out card stays on the page. */
  .card[hidden] {
    display: none;
  }

  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.75rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-line);
  }

  /* Media left, text right, from tablet up. Both tracks are fractional so the
     photographs grow with the viewport instead of stopping at a fixed width and
     leaving the frames small on a wide screen. The ratio still puts every
     card's text on the same vertical line, which is what makes a long list
     scannable.
     A card with no capture yet has no image column at all, and its text takes
     the full width rather than sitting in an empty one. */
  @media (min-width: 720px) {
    .card[data-media='yes'] {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  /* One large frame and two stacked beside it. With fewer than three the grid
     collapses to what is there rather than leaving a hole. */
  .card__media {
    display: grid;
    /* A link, so it needs the reset a link inside a card does not get for free. */
    text-decoration: none;
    color: inherit;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
  }

  .card__media[data-count='1'] {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }

  .card__media[data-count='2'] {
    grid-template-rows: 1fr;
  }

  .card__media img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--color-mist);
    transition: opacity 160ms ease;
  }

  .card__media:hover img,
  .card__media:focus-visible img {
    opacity: 0.88;
  }

  .card__media img:first-child {
    grid-row: 1 / -1;
    aspect-ratio: auto;
  }

  .card__media[data-count='1'] img:first-child,
  .card__media[data-count='2'] img:first-child {
    grid-row: auto;
    aspect-ratio: 3 / 2;
  }

  /* Body ------------------------------------------------------------------- */

  .card__aside {
    min-width: 0;
  }

  .card__body {
    min-width: 0;
  }

  .card__head h3 {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.3;
    /* Trip.com hands these over in whatever case the owner typed: nineteen are
       already shouting, twenty-one open lowercase and sixty carry a lowercase
       word in the middle. Uppercasing in CSS rather than in the data levels
       them without editing anybody's name, so the property page, the link and
       the accessible text all still carry it as written. */
    text-transform: uppercase;
    letter-spacing: 0.02em;
    /* Long transliterated names run past any column; wrapping beats an ellipsis
       that hides the half you were looking for. */
    overflow-wrap: anywhere;
  }

  .card__head h3 a {
    color: var(--color-bamboo);
    text-decoration: none;
  }

  .card__head h3 a:hover,
  .card__head h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card__meta {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .card__meta strong {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .card__price {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .card__price-unit {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .card__flag {
    font-weight: 600;
    color: var(--color-bamboo);
    text-decoration: none;
    white-space: nowrap;
  }

  .card__flag:hover,
  .card__flag:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card__desc p {
    margin: 0.9rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* The topic label reads as a run-in heading rather than a chip: it is part of
     the sentence, and boxing it would give a machine summary the authority of a
     section title. */
  .card__topic {
    font-weight: 600;
    color: var(--color-ink);
  }

  .card__topic::after {
    content: '. ';
  }

  .card__basis {
    color: var(--color-muted);
  }

  .card__quote {
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-stone);
  }

  .card__quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .card__quote figcaption {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .card__pending {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* Centred under the frames, since the column above it is the photographs
     rather than a line of prose to align a button to. */
  .card__actions {
    margin: 1rem 0 0;
    text-align: center;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-bamboo);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--color-line);
    white-space: nowrap;
  }

  .card__cta:hover,
  .card__cta:focus-visible {
    background: var(--color-mist-50);
    box-shadow: inset 0 0 0 1px var(--color-bamboo);
  }

</style>
