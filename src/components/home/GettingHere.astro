---
import SectionHead from '../SectionHead.astro';

/**
 * Getting here: the journey as a diagram, then the four route pages.
 *
 * The diagram is the thing no competing page shows. Almost everyone makes
 * three separate moves, train to Deqing, road up to the town, then a change
 * to scenic area transport at the barrier, and most English pages describe
 * only the first. Four stops and three legs, with the leg times from the
 * route articles, say it in one glance. The legs draw themselves as the block
 * enters the viewport: a line arriving one leg at a time is the journey.
 *
 * This is the module the practical half exists for. The demand that exists
 * for this destination is logistical and it comes from people already in
 * Shanghai or Hangzhou, so the four links under the diagram are worth more
 * traffic than anything else on the page.
 */
const STOPS = [
  { name: 'Shanghai Hongqiao', note: 'or Hangzhou East' },
  { name: 'Deqing station', note: 'not Moganshan station' },
  { name: 'Moganshan town', note: 'the transfer barrier' },
  { name: 'The mountain', note: 'the summit is 720 m' },
];

const LEGS = [
  { how: 'High speed train', time: '63 to 80 min', alt: '13 to 17 min from Hangzhou' },
  { how: 'Shuttle or taxi', time: '30 to 40 min', alt: 'RMB 10 or about RMB 100' },
  { how: 'Scenic area shuttle', time: 'no private cars', alt: 'transfer centres 08:00 to 18:00' },
];

const ROUTES = [
  { title: 'From Shanghai', sub: 'train, car, transfers', href: '/getting-here/from-shanghai' },
  { title: 'From Hangzhou', sub: '13 minutes, then what', href: '/getting-here/from-hangzhou' },
  { title: 'From the airports', sub: 'Hongqiao, Pudong, Xiaoshan', href: '/getting-here/from-the-airports' },
  { title: 'Getting around', sub: 'the no cars rule', href: '/getting-here/getting-around' },
];
---

<section class="vm-section getting" id="getting-here" aria-labelledby="getting-title">
  <div class="vm-container">
    <div data-reveal>
      <SectionHead
        id="getting-title"
        title="Getting here is three moves, not one"
        lede="A train to Deqing, a road up to the town, and a change of vehicle at the scenic area barrier. Most pages describe only the first."
        linkLabel="All routes"
        linkHref="/getting-here"
      />
    </div>

    <ol class="journey" data-draw aria-label="The journey in three legs">
      {
        STOPS.map((stop, i) => (
          <li class="stop" style={`--i:${i}`}>
            <span class="stop__dot" aria-hidden="true" />
            <span class="stop__name">{stop.name}</span>
            <span class="stop__note">{stop.note}</span>
            {LEGS[i] && (
              <span class="leg" aria-label={`Then ${LEGS[i].how}, ${LEGS[i].time}`}>
                <span class="leg__line" aria-hidden="true" />
                <span class="leg__how">{LEGS[i].how}</span>
                <span class="leg__time">{LEGS[i].time}</span>
                <span class="leg__alt">{LEGS[i].alt}</span>
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <ul class="routes">
      {
        ROUTES.map((route, i) => (
          <li style={`--i:${i}`} data-reveal>
            <a href={route.href}>
              <h3>{route.title}</h3>
              <p>{route.sub}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .getting {
    background: var(--color-mist);
  }

  /* --- The journey diagram --- */

  /* Vertical on a phone: dots down the left, legs between them. Horizontal
     from 900px: four stops across, three legs between. */
  .journey {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    list-style: none;
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    grid-template-areas:
      'dot name'
      'dot note'
      'leg leg';
    column-gap: 0.9rem;
    align-items: baseline;
  }

  .stop__dot {
    grid-area: dot;
    align-self: center;
    width: 14px;
    height: 14px;
    margin-left: 4px;
    border: 3px solid var(--color-bamboo);
    border-radius: 50%;
    background: var(--color-paper);
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 400ms ease;
    transition-delay: calc(var(--i) * 420ms);
  }

  .stop:last-child .stop__dot {
    background: var(--color-amber);
    border-color: var(--color-bamboo);
  }

  .stop__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-bamboo);
  }

  .stop__note {
    grid-area: note;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* --- One leg: the line and its label --- */

  .leg {
    grid-area: leg;
    position: relative;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    column-gap: 0.9rem;
    padding: 0.85rem 0 1rem;
  }

  .leg__line {
    grid-row: 1 / 4;
    justify-self: center;
    width: 2px;
    height: 100%;
    background: var(--color-bamboo);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 420ms + 120ms);
  }

  .leg__how {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .leg__time {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-bamboo);
    font-variant-numeric: tabular-nums;
  }

  .leg__alt {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .leg__how,
  .leg__time,
  .leg__alt {
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 500ms ease,
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 420ms + 360ms);
  }

  /* Drawn in once the block reveals. Without the motion attribute (scripts
     off, or reduced motion) everything is simply visible. */
  :global([data-motion]) .journey.is-in .stop__dot,
  :global(html:not([data-motion])) .stop__dot {
    transform: scale(1);
    opacity: 1;
  }

  :global([data-motion]) .journey.is-in .leg__line,
  :global(html:not([data-motion])) .leg__line {
    transform: scaleY(1);
  }

  :global([data-motion]) .journey.is-in .leg__how,
  :global([data-motion]) .journey.is-in .leg__time,
  :global([data-motion]) .journey.is-in .leg__alt,
  :global(html:not([data-motion])) .leg__how,
  :global(html:not([data-motion])) .leg__time,
  :global(html:not([data-motion])) .leg__alt {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 900px) {
    .journey {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 1.5rem 0 0.5rem;
    }

    .stop {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'dot'
        'name'
        'note'
        'leg';
      row-gap: 0.15rem;
      /* Start aligned, not baseline: the last stop has no leg row, and
         baseline alignment let it drift down against its neighbours. */
      align-items: start;
      align-content: start;
      padding-right: 1.5rem;
    }

    .stop__dot {
      margin: 0 0 0.75rem;
      width: 16px;
      height: 16px;
    }

    .leg {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0.75rem;
      padding: 0.75rem 0 0;
    }

    /* The vertical hairline of the phone layout is replaced by a line drawn
       from this stop's dot to the next stop's, across the column, left to
       right. The dot is the first row of the stop and 16px tall, so the line
       sits 7px down from the top of the stop. */
    .leg__line {
      display: none;
    }

    .stop:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 7px;
      left: 16px;
      right: -2px;
      height: 2px;
      background: var(--color-bamboo);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--i) * 420ms + 120ms);
    }

    :global([data-motion]) .journey.is-in .stop::before,
    :global(html:not([data-motion])) .stop::before {
      transform: scaleX(1);
    }
  }

  /* --- The four route pages --- */

  .routes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .routes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .routes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .routes a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 400ms ease;
  }

  .routes a:hover {
    border-color: var(--color-bamboo);
    transform: translateY(-3px);
    box-shadow: 0 22px 40px -28px color-mix(in srgb, var(--color-bamboo) 55%, transparent);
  }

  .routes h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .routes p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .routes a {
      transition: none;
    }

    .routes a:hover {
      transform: none;
    }
  }
</style>
