---
import ContentsBar from '../ContentsBar.astro';

/**
 * The home page contents bar: the seven parts of the front in order. The
 * mechanics live in components/ContentsBar.astro, which every long page
 * shares. Add a section, add a row here, and keep the order the page has.
 */
const ITEMS = [
  { id: 'latest', label: 'Latest' },
  { id: 'mountain', label: 'The mountain' },
  { id: 'things-to-do', label: 'Things to do' },
  { id: 'plan', label: 'Where to stay' },
  { id: 'getting-here', label: 'Getting here' },
  { id: 'places', label: 'Ten places' },
  { id: 'when-to-go', label: 'When to go' },
];
---

<ContentsBar items={ITEMS} label="On this page" />
