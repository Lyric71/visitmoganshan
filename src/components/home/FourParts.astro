---
import SectionHead from '../SectionHead.astro';

/**
 * What this mountain is. Four photographs as one spread: the bamboo forest
 * takes the tall left cell, the other three stack beside it.
 *
 * The type sits on the picture, on a scrim that only darkens the bottom third,
 * so the photograph stays the point. Hovering opens the picture slightly and
 * lifts the line under the title; nothing else moves. The four reveal in
 * sequence as the spread enters the viewport.
 */
const PARTS = [
  {
    title: 'The bamboo forest',
    sub: '92 percent forest cover, and a working crop',
    href: '/moganshan/bamboo-forest',
    image: '/images/part-bamboo.webp',
    alt: 'Sunlight raking between the culms of a working bamboo grove at Moganshan',
  },
  {
    title: 'The villas',
    sub: 'British, American, French, all in local stone',
    href: '/moganshan/hill-station/the-villas',
    image: '/images/part-villas.webp',
    alt: 'A row of old stone summer villas along a mountain lane at Moganshan',
  },
  {
    title: 'The villages',
    sub: 'Yucun, Xiantan, Sanjiuwu',
    href: '/moganshan/villages',
    image: '/images/part-villages.webp',
    alt: 'A quiet village lane below Moganshan, tiled roofs above a stone drainage channel',
  },
  {
    title: 'The tea',
    sub: 'yellow bud, grown on the slopes',
    href: '/moganshan/tea',
    image: '/images/part-tea.webp',
    alt: 'Terraced tea bushes curving around a misty hillside below the bamboo forest',
  },
];
---

<section class="vm-section" id="mountain" aria-labelledby="four-parts-title">
  <div class="vm-container">
    <div data-reveal>
      <SectionHead
        id="four-parts-title"
        title="What this mountain is"
        lede="A hill station built by Shanghai's foreign residents in the 1890s, a bamboo crop that still pays the villages, and a tea that grows nowhere else."
        linkLabel="Discover Moganshan"
        linkHref="/moganshan"
      />
    </div>
    <ul class="spread">
      {
        PARTS.map((part, i) => (
          <li class="spread__cell" style={`--i:${i}`} data-reveal>
            <a class="tile" href={part.href}>
              <img
                src={part.image}
                alt={part.alt}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <span class="tile__text">
                <span class="tile__title">{part.title}</span>
                <span class="tile__sub">{part.sub}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spread__cell {
    min-height: 240px;
  }

  @media (min-width: 640px) {
    .spread {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spread__cell:first-child {
      grid-column: 1 / -1;
      min-height: 360px;
    }
  }

  @media (min-width: 1024px) {
    .spread {
      grid-template-columns: 1.35fr 1fr 1fr;
      grid-template-rows: 300px 300px;
      gap: 1rem;
    }

    .spread__cell:first-child {
      grid-column: 1;
      grid-row: 1 / 3;
      min-height: 0;
    }

    .spread__cell:nth-child(2) {
      grid-column: 2 / 4;
    }
  }

  .tile {
    position: relative;
    display: block;
    height: 100%;
    min-height: inherit;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-stone);
    text-decoration: none;
    isolation: isolate;
  }

  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-ink) 78%, transparent) 0%,
      color-mix(in srgb, var(--color-ink) 30%, transparent) 38%,
      transparent 68%
    );
    transition: opacity 400ms ease;
  }

  .tile:hover img,
  .tile:focus-visible img {
    transform: scale(1.05);
  }

  .tile__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: clamp(1rem, 2.4vw, 1.5rem);
    color: var(--color-mist);
  }

  .tile__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 500;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 1px 14px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }

  .tile__title::after {
    content: '';
    display: block;
    width: 2.25rem;
    height: 2px;
    margin-top: 0.6rem;
    background: var(--color-amber);
    transform-origin: left;
    transform: scaleX(0.55);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile:hover .tile__title::after {
    transform: scaleX(1);
  }

  .tile__sub {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-mist);
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile img,
    .tile__title::after {
      transition: none;
    }

    .tile:hover img {
      transform: none;
    }
  }
</style>
