---
import SectionHead from '../SectionHead.astro';
import { ITINERARIES } from '../../data/itineraries';

/**
 * 6.11 Ready-made itineraries.
 *
 * Card one says "and why we would not" and it stays that way. The day trip is
 * the page where length of stay gets won, and the honest answer about a five
 * hour round trip is what earns the second night.
 */
---

<section class="vm-section" aria-labelledby="itineraries-title">
  <div class="vm-container">
    <SectionHead
      id="itineraries-title"
      title="Ready-made itineraries"
      linkLabel="All itineraries"
      linkHref="/itineraries"
    />
    <ol class="itins">
      {
        ITINERARIES.map((itinerary, i) => (
          <li>
            <a href={itinerary.href}>
              <span class="itins__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="itins__text">
                <h3>{itinerary.title}</h3>
                <p>{itinerary.sub}</p>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .itins {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .itins a {
    display: flex;
    gap: 1rem;
    height: 100%;
    padding: 1.5rem 1.25rem;
    background: var(--color-stone);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .itins a:hover {
    background: color-mix(in srgb, var(--color-stone) 82%, var(--color-bamboo));
  }

  /* Decorative numbering only. The list is already an <ol>, so the count is in
     the semantics; this is the visual echo of it. */
  .itins__index {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .itins h3 {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  .itins p {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
  }
</style>
