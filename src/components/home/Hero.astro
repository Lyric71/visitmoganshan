---
/**
 * 6.2 Hero.
 *
 * Near full height: `100svh` minus the sticky header on desktop, 88svh on
 * phones. The small viewport unit rather than `vh` so the mobile browser
 * chrome cannot push the buttons under the fold on first paint. The band below
 * announces itself with the bottom gradient landing on bamboo, which is the
 * hill station band's own background, so the fold reads as a seam rather than
 * as the end of the page.
 *
 * No search box, no carousel. Nobody arrives at a small destination site
 * knowing what to search for, and a rotating hero is a way of admitting no
 * single picture was good enough. What the picture gets instead is time: a very
 * slow push in, so the frame is never quite still while a reader is deciding
 * whether to stay.
 *
 * The locator line above the title is not decoration. Three different things
 * share this name in the index, and Moganshan Road (the M50 art district in
 * Shanghai) has already broken into the top ten for "what to do in moganshan".
 * The destination has to be pinned to Deqing County inside the first hundred
 * words of visible copy or the page competes with the wrong entity. Above the
 * h1 rather than below it because a kicker is read first and the title is the
 * ambiguous word.
 *
 * The live conditions panel sits opposite for the same reason: weather on a
 * hill an hour from the sea is the first practical question a reader has, and
 * it doubles as proof the page is about a real place with an altitude.
 *
 * On scroll the picture falls away more slowly than the page, a CSS scroll
 * driven animation with no script, so the fold reads as a page turning over
 * a photograph rather than a photograph sliding off. Browsers without
 * scroll timelines get the still frame. There is no scroll cue: a reader who
 * has not scrolled is looking at the hero, and the contents bar under it
 * says what follows.
 *
 * Every moving part here is decoration over a legible still frame. Under
 * `prefers-reduced-motion` the push in, the parallax and the entrance stagger
 * all stop and the hero renders at its final state.
 */
import HeroWeather from './HeroWeather.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <picture class="hero__media">
    <source srcset="/images/hero.webp" type="image/webp" />
    <img
      src="/images/hero.jpg"
      alt="Morning mist in the bamboo forest at Moganshan"
      width="1536"
      height="1024"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <div class="vm-container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-rule" aria-hidden="true"></span>
        Deqing County, Huzhou · Zhejiang, China · north of Hangzhou
      </p>
      <h1 id="hero-title" class="hero__title">Moganshan</h1>
      <p class="hero__tagline">
        A mountain that Shanghai built a second life on, and then forgot.
      </p>
      <div class="hero__actions">
        <a class="vm-btn" href="/moganshan/hill-station">Read the story</a>
        <a class="vm-btn vm-btn--ghost-reversed" href="/where-to-stay">Where to stay</a>
      </div>
    </div>
    <HeroWeather />
  </div>

</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 88svh;
    padding-block: clamp(3rem, 8vw, 5rem) clamp(4.5rem, 9vw, 7rem);
    background: var(--color-bamboo);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  /* Parallax: the picture travels at about a third of the page speed over
     the first viewport of scroll. Scroll driven, so it costs no script and
     never fires a scroll listener. */
  @supports (animation-timeline: scroll()) {
    .hero__media {
      animation: hero-parallax linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100vh;
    }
  }

  @keyframes hero-parallax {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(28%);
    }
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 50%;
    /* Held slightly over full size at rest so the animated push in never
       exposes an edge, and so the still frame under reduced motion is the same
       crop as the moving one. */
    transform: scale(1.06);
    transform-origin: 58% 45%;
    animation: hero-push 34s cubic-bezier(0.33, 0, 0.25, 1) infinite alternate;
    will-change: transform;
  }

  @keyframes hero-push {
    from {
      transform: scale(1.06) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.17) translate3d(-1.2%, -0.8%, 0);
    }
  }

  /* Two layers rather than one. The lower gradient carries the type contrast
     and lands on bamboo so the hero dissolves into the band beneath it instead
     of stopping at a hard edge. The vignette pulls the corners down, which is
     what makes a photograph read as a frame rather than as a background. */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero::before {
    z-index: -2;
    background:
      radial-gradient(
        130% 95% at 62% 34%,
        transparent 34%,
        color-mix(in srgb, var(--color-ink) 55%, transparent) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-ink) 60%, transparent) 0%,
        color-mix(in srgb, var(--color-ink) 22%, transparent) 42%,
        transparent 70%
      );
  }

  .hero::after {
    z-index: -1;
    background: linear-gradient(
      to top,
      var(--color-bamboo) 0%,
      color-mix(in srgb, var(--color-ink) 84%, transparent) 12%,
      color-mix(in srgb, var(--color-ink) 58%, transparent) 34%,
      color-mix(in srgb, var(--color-ink) 16%, transparent) 62%,
      transparent 86%
    );
  }

  .hero__inner {
    position: relative;
    max-width: 1180px;
  }

  .hero__copy {
    max-width: 46ch;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: clamp(0.9rem, 2vw, 1.35rem);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-mist-muted);
  }

  .hero__eyebrow-rule {
    display: block;
    flex: none;
    width: clamp(1.75rem, 5vw, 3rem);
    height: 1px;
    background: var(--color-amber);
  }

  .hero__title {
    /* Far past the global h1 scale. This is the one display moment on the site
       and the word is short enough to carry it at any width. */
    font-size: clamp(3.25rem, 13vw, 8.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--color-mist);
    /* A soft drop under the type rather than a heavier scrim over the picture:
       it buys the contrast without flattening the bamboo behind it. */
    text-shadow: 0 2px 28px color-mix(in srgb, var(--color-ink) 55%, transparent);
  }

  .hero__tagline {
    max-width: 32ch;
    margin-top: clamp(1rem, 2.4vw, 1.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.8vw, 1.75rem);
    font-style: italic;
    line-height: 1.35;
    color: var(--color-mist);
    text-shadow: 0 1px 18px color-mix(in srgb, var(--color-ink) 55%, transparent);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* --- Entrance --- */

  /* Staggered, and the title carries a little blur and open tracking on the way
     in so it resolves rather than slides. Everything settles inside a second. */
  .hero__eyebrow,
  .hero__title,
  .hero__tagline,
  .hero__actions {
    animation: hero-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .hero__eyebrow {
    animation-delay: 80ms;
  }

  .hero__title {
    animation-name: hero-resolve;
    animation-duration: 1200ms;
    animation-delay: 160ms;
  }

  .hero__tagline {
    animation-delay: 380ms;
  }

  .hero__actions {
    animation-delay: 540ms;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-resolve {
    from {
      opacity: 0;
      letter-spacing: 0.06em;
      filter: blur(14px);
      transform: translateY(1.75rem);
    }
    to {
      opacity: 1;
      letter-spacing: -0.03em;
      filter: blur(0);
      transform: none;
    }
  }

  /* On phones the copy plus the weather panel fill most of the frame, so the
     title sits far higher than the gradients above were tuned for. Carry the
     dark further up rather than shrinking the type. */
  @media (max-width: 767px) {
    .hero::after {
      background: linear-gradient(
        to top,
        var(--color-bamboo) 0%,
        color-mix(in srgb, var(--color-ink) 86%, transparent) 10%,
        color-mix(in srgb, var(--color-ink) 68%, transparent) 45%,
        color-mix(in srgb, var(--color-ink) 44%, transparent) 78%,
        color-mix(in srgb, var(--color-ink) 22%, transparent) 100%
      );
    }
  }

  @media (min-width: 768px) {
    .hero {
      /* Full viewport under the sticky 68px header, so the picture owns the
         first screen and the band below starts exactly at the fold. */
      min-height: calc(100svh - 68px);
    }

    /* The weather panel sits opposite the copy and settles on the same bottom
       line, so the two blocks read as one band rather than two floating cards.
       Below this width there is no room for a second column and the panel
       falls back to full width under the buttons. */
    .hero__inner {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img,
    .hero__eyebrow,
    .hero__title,
    .hero__tagline,
    .hero__actions,
    .hero__media {
      animation: none;
    }
  }
</style>
