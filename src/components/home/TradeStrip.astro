---
/**
 * 6.14 Trade strip. A quiet band on stone.
 *
 * Heading is an h3, not an h2, and the band is deliberately low-contrast: this
 * is for operators and journalists, and it must not compete with the visitor
 * path it sits under.
 */
---

<section class="trade" aria-labelledby="trade-title">
  <div class="vm-container trade__inner">
    <div>
      <h3 id="trade-title">Tour operators, DMCs and media</h3>
      <p>Fact sheet, operator-ready itinerary modules and a free image library.</p>
    </div>
    <a class="vm-btn vm-btn--ghost" href="/trade">Trade resources</a>
  </div>
</section>

<style>
  .trade {
    background: var(--color-stone);
    padding-block: clamp(2.25rem, 4vw, 3rem);
  }

  .trade__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }

  .trade h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .trade p {
    max-width: 52ch;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }
</style>
