---
import SectionHead from '../SectionHead.astro';
import TabGroup from '../TabGroup.astro';
import { pickStays } from '../../lib/stay-picks';
import { TYPE_LABEL, TYPE_ORDER, TYPE_SLUG, countOfType, goPath, typePath } from '../../lib/stays';

/**
 * 6.9 Where to stay.
 *
 * The tabs are the seven kinds of place the header menu lists, built from the
 * same TYPE_ORDER, so a type added to the directory appears here, in the menu
 * and on its own listing page from one edit. They used to be a separate set of
 * mood categories (Luxury, Boutique, Family) filled with placeholder rows,
 * which meant the home page offered a taxonomy the rest of the site did not
 * have and six cards that said TODO.
 *
 * Each tab shows five real properties from the affiliate directory, sampled at
 * build time (see lib/stay-picks), and links on to all of that kind.
 *
 * Every property is presented on the same terms. There is no featured slot, no
 * sponsored treatment and no "our pick" badge, and nothing in the sample can
 * create one: the order is a hash. That constraint is the product. The moment
 * one card looks bought, every other card stops being evidence.
 *
 * Nothing on a card is written by us. The photograph, the score and the price
 * are Trip.com's, and the link says so again.
 *
 * This is the first section of the practical half, so it carries the two
 * attributes the old divider band used to own: id="plan", so the whole second
 * half is reachable at visitmoganshan.com/#plan, and data-plan-anchor, the
 * trigger for the mobile plan bar; see PlanBar.astro.
 */
const panels = TYPE_ORDER.map((type) => ({
  type,
  tab: { id: TYPE_SLUG[type], label: TYPE_LABEL[type] },
  picks: pickStays(type, 5),
  count: countOfType(type),
}));

const tabs = panels.map((panel) => panel.tab);
---

<section class="vm-section" id="plan" aria-labelledby="stay-title" data-plan-anchor>
  <div class="vm-container">
    <SectionHead
      id="stay-title"
      title="Where to stay"
      linkLabel="The 12 best hotels, ranked"
      linkHref="/where-to-stay/best-hotels"
    />

    <TabGroup id="stay" label="Filter places to stay" tabs={tabs}>
      {
        panels.map(({ type, tab, picks, count }, i) => (
          <div
            id={`stay-panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`stay-tab-${tab.id}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <ul class="grid">
              {picks.map(({ row, capture, image }) => (
                <li>
                  <article class="stay">
                    <div class="stay__media">
                      {image ? (
                        <img
                          src={image}
                          alt={`${row.name}, listing photograph`}
                          width="600"
                          height="400"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="stay__nomedia">No photograph yet</span>
                      )}
                    </div>

                    <div class="stay__body">
                      <h3 class="stay__name">{row.name}</h3>
                      <p class="stay__meta">
                        {row.city}
                        {capture?.rating && (
                          <>
                            {' · '}
                            <strong>
                              {capture.rating.score.toFixed(1)}/{capture.rating.scale}
                            </strong>
                          </>
                        )}
                      </p>
                      {capture?.priceRange && <p class="stay__price">{capture.priceRange}</p>}
                      <a
                        class="stay__cta"
                        href={goPath(row.goSlug)}
                        rel="sponsored noopener"
                        target="_blank"
                        aria-label={`Check dates for ${row.name} on Trip.com, opens in a new tab`}
                      >
                        Check dates
                      </a>
                    </div>
                  </article>
                </li>
              ))}
            </ul>

            <p class="panel__all">
              <a class="vm-more" href={typePath(type)}>
                All {count.toLocaleString('en-GB')} {TYPE_LABEL[type].toLowerCase()}
              </a>
            </p>
          </div>
        ))
      }
    </TabGroup>
  </div>
</section>

<style>
  /* Steps 1 -> 3 -> 5. Five is the sample size, so the widest step fits a whole
     tab on one line; at the middle step three and two is the least ragged of
     the ways five can break. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  /* --- One property --- */

  .stay {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 180ms ease;
  }

  .stay:hover,
  .stay:focus-within {
    border-color: var(--color-bamboo);
  }

  .stay__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    background: var(--color-stone);
  }

  .stay__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stay__nomedia {
    padding: 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
  }

  .stay__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.9rem 1rem 1.1rem;
  }

  .stay__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-bamboo);
    /* Transliterated names run long and there is no ellipsis that hides the
       useful half of one honestly. */
    overflow-wrap: anywhere;
  }

  .stay__meta {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .stay__meta strong {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .stay__price {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* The one link in the card, stretched over the whole surface. A second
     anchor here would either nest (invalid) or sit under the overlay and never
     be clickable, so the card has exactly one destination and it is the one the
     label names. */
  .stay__cta {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-bamboo);
    text-decoration: none;
  }

  .stay__cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .stay__cta:hover,
  .stay:hover .stay__cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .panel__all {
    margin-top: 0.5rem;
  }

  [role='tabpanel']:focus {
    outline: none;
  }
</style>
