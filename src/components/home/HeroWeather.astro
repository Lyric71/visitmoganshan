---
/**
 * Live conditions on the mountain, as a panel on the right of the hero.
 *
 * Source: Open Meteo (https://open-meteo.com). No key, no attribution banner
 * required, CORS open, and it does not log the visitor to a third party the
 * way an embedded widget would.
 *
 * Fetched in the browser on every page view rather than baked at build time.
 * The site is statically generated, so a build time value would be stale from
 * the moment it deployed. The cost is one small request that starts after the
 * hero image is already painting, and the markup ships hidden so a failed or
 * slow request leaves the hero exactly as it was.
 *
 * Coordinates are the summit village in Deqing County, not Moganshan Road in
 * Shanghai. Same reasoning as the locator line in the hero.
 */
---

<aside class="wx" data-weather hidden aria-label="Current weather at Moganshan">
  <p class="wx__eyebrow">On the mountain now</p>

  <div class="wx__read">
    <span class="wx__icon" data-weather-icon aria-hidden="true"></span>
    <span class="wx__temp" data-weather-temp></span>
  </div>

  <p class="wx__condition" data-weather-condition></p>

  <dl class="wx__meta">
    <div>
      <dt>Today</dt>
      <dd data-weather-range></dd>
    </div>
    <div>
      <dt>Summit</dt>
      <dd>720 m</dd>
    </div>
    <div>
      <dt>Local time</dt>
      <dd data-weather-time></dd>
    </div>
  </dl>
</aside>

<script>
  const LATITUDE = 30.6;
  const LONGITUDE = 119.885;
  /**
   * Metres. The nearest model grid cell sits at 135 m, down in the valley, and
   * reports three to four degrees warm. Passing the summit height makes Open
   * Meteo downscale to the ridge, which is the number the whole hill station
   * exists for and the one a reader on this page is asking about.
   */
  const ELEVATION = 720;

  const ENDPOINT =
    'https://api.open-meteo.com/v1/forecast' +
    `?latitude=${LATITUDE}&longitude=${LONGITUDE}&elevation=${ELEVATION}` +
    '&current=temperature_2m,weather_code,is_day' +
    '&daily=temperature_2m_max,temperature_2m_min' +
    '&timezone=Asia%2FShanghai&forecast_days=1';

  /**
   * WMO code to plain English, sentence case, because the label reads as a
   * caption under the temperature rather than as a data field.
   */
  const CONDITIONS: Record<number, string> = {
    0: 'Clear sky',
    1: 'Mainly clear',
    2: 'Partly cloudy',
    3: 'Overcast',
    45: 'Fog',
    48: 'Freezing fog',
    51: 'Light drizzle',
    53: 'Drizzle',
    55: 'Heavy drizzle',
    56: 'Freezing drizzle',
    57: 'Freezing drizzle',
    61: 'Light rain',
    63: 'Rain',
    65: 'Heavy rain',
    66: 'Freezing rain',
    67: 'Freezing rain',
    71: 'Light snow',
    73: 'Snow',
    75: 'Heavy snow',
    77: 'Snow grains',
    80: 'Light showers',
    81: 'Showers',
    82: 'Heavy showers',
    85: 'Snow showers',
    86: 'Snow showers',
    95: 'Thunderstorm',
    96: 'Thunderstorm with hail',
    99: 'Thunderstorm with hail',
  };

  /**
   * Line art at 44 px, stroked in currentColor. Drawn rather than pulled from
   * an icon font so the weights match the rest of the page and nothing extra
   * has to download before the panel can appear.
   */
  const SUN =
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M19.1 4.9l-1.5 1.5M6.4 17.6l-1.5 1.5"/>';
  const MOON = '<path d="M20 14.5A8 8 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/>';
  const CLOUD = '<path d="M7.5 19h10a3.5 3.5 0 0 0 .4-7A5.5 5.5 0 0 0 7.2 11 4 4 0 0 0 7.5 19z"/>';

  const ICONS: Record<string, string> = {
    clear: SUN,
    clearNight: MOON,
    partly:
      '<circle cx="8.5" cy="8" r="3"/><path d="M8.5 2v1.6M8.5 12.4V14M2.5 8h1.6M12.9 8h1.6M4.2 3.7l1.2 1.2M11.6 11.1l1.2 1.2M12.8 3.7l-1.2 1.2M5.4 11.1l-1.2 1.2"/><path d="M9 20h8.5a3 3 0 0 0 .3-6A4.7 4.7 0 0 0 9 13.4 3.3 3.3 0 0 0 9 20z"/>',
    partlyNight:
      '<path d="M14.5 9.5A5 5 0 0 1 8 3a5.4 5.4 0 1 0 6.5 6.5z"/><path d="M9 20h8.5a3 3 0 0 0 .3-6A4.7 4.7 0 0 0 9 13.4 3.3 3.3 0 0 0 9 20z"/>',
    cloud: CLOUD,
    fog: '<path d="M5 7.5h14M4 12h16M6 16.5h12M8 21h8"/>',
    drizzle: CLOUD + '<path d="M9 21.3v1.4M13 21.3v1.4M17 21.3v1.4"/>',
    rain: CLOUD + '<path d="M8.6 20.6 7.4 23.4M12.6 20.6 11.4 23.4M16.6 20.6 15.4 23.4"/>',
    snow: CLOUD + '<path d="M9 21.6h.01M13 21.6h.01M17 21.6h.01M11 23.8h.01M15 23.8h.01"/>',
    thunder: CLOUD + '<path d="M13.5 20h-3.8l3.4 2.4-1 2.1"/>',
  };

  /**
   * Moganshan's wall clock, derived here rather than read off the payload.
   *
   * Open Meteo stamps `current.time` at the last 15 minute step, so printing it
   * under a label that says "Local time" shows a clock up to a quarter of an
   * hour slow, and then frozen for as long as the tab stays open. Deriving it
   * from the visitor's own clock in Asia/Shanghai is exact instead: China keeps
   * one zone and observes no daylight saving, so there is no offset to track.
   */
  const CLOCK = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Shanghai',
  });

  function startClock(el: HTMLElement) {
    const tick = () => {
      el.textContent = CLOCK.format(new Date());
    };
    tick();
    // Twice a minute, so the display is never more than 30 seconds behind the
    // rollover. One text write on a timer costs nothing.
    window.setInterval(tick, 30_000);
  }

  function iconKey(code: number, day: boolean): string {
    if (code === 0 || code === 1) return day ? 'clear' : 'clearNight';
    if (code === 2) return day ? 'partly' : 'partlyNight';
    if (code === 3) return 'cloud';
    if (code === 45 || code === 48) return 'fog';
    if (code >= 51 && code <= 57) return 'drizzle';
    if (code >= 71 && code <= 77) return 'snow';
    if (code === 85 || code === 86) return 'snow';
    if (code >= 95) return 'thunder';
    return 'rain';
  }

  async function render() {
    const root = document.querySelector<HTMLElement>('[data-weather]');
    if (!root) return;

    const icon = root.querySelector<HTMLElement>('[data-weather-icon]');
    const temp = root.querySelector<HTMLElement>('[data-weather-temp]');
    const condition = root.querySelector<HTMLElement>('[data-weather-condition]');
    const range = root.querySelector<HTMLElement>('[data-weather-range]');
    const clock = root.querySelector<HTMLElement>('[data-weather-time]');
    if (!icon || !temp || !condition || !range || !clock) return;

    let data;
    try {
      const response = await fetch(ENDPOINT, { cache: 'no-store' });
      if (!response.ok) return;
      data = await response.json();
    } catch {
      // Offline, blocked, or the API is down. The hero simply does without.
      return;
    }

    const now = data?.current;
    if (!now || typeof now.temperature_2m !== 'number') return;

    const code = Number(now.weather_code);

    icon.innerHTML =
      '<svg viewBox="0 0 24 26" width="44" height="48" fill="none" stroke="currentColor" ' +
      'stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">' +
      ICONS[iconKey(code, now.is_day !== 0)] +
      '</svg>';

    // The degree sign in the display serif is drawn large and rides high, so
    // it gets its own span and is set back down to size.
    temp.innerHTML = `${Math.round(now.temperature_2m)}<span class="wx__deg">°</span>`;
    condition.textContent = CONDITIONS[code] ?? 'Unsettled';

    const high = data?.daily?.temperature_2m_max?.[0];
    const low = data?.daily?.temperature_2m_min?.[0];
    if (typeof high === 'number' && typeof low === 'number') {
      range.textContent = `${Math.round(low)}° to ${Math.round(high)}°`;
    } else {
      // No forecast in the payload, so drop the label rather than print a
      // placeholder that looks like a broken value.
      range.closest('div')?.remove();
    }

    startClock(clock);

    root.hidden = false;
  }

  render();
</script>

<style>
  /* Glass over a photograph, not a solid card. The picture stays readable
     through it, which is the point of putting it in the hero at all, and the
     tint carries enough weight for the type to clear 4.5:1 wherever the frame
     goes bright. */
  .wx {
    width: 100%;
    max-width: 20rem;
    margin-top: 2rem;
    padding: 1.15rem 1.35rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-mist) 22%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-ink) 42%, transparent);
    color: var(--color-mist);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
  }

  .wx[hidden] {
    display: none;
  }

  .wx__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mist-muted);
  }

  .wx__read {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.6rem;
  }

  .wx__icon {
    display: inline-flex;
    flex: none;
    color: var(--color-amber);
  }

  .wx__temp {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Global because the span is written by the script and never carries Astro's
     scope attribute. */
  .wx__temp :global(.wx__deg) {
    font-size: 0.5em;
    /* The glyph already carries its own top bearing, so it only needs a nudge
       to sit level with the cap height instead of floating above it. */
    vertical-align: 0.36em;
    margin-left: 0.04em;
  }

  .wx__condition {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    color: var(--color-mist);
  }

  .wx__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--color-mist) 18%, transparent);
  }

  .wx__meta dt {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mist-muted);
  }

  .wx__meta dd {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /* Phones get the same panel at a lower weight. Full size, it pushes the
     title up into the brightest part of the photograph and costs more vertical
     space than the buttons it sits under. */
  @media (max-width: 767px) {
    .wx {
      max-width: none;
      margin-top: 1.5rem;
      padding: 0.9rem 1.05rem 1rem;
    }

    .wx__read {
      gap: 0.6rem;
      margin-top: 0.45rem;
    }

    /* Global for the same reason as the degree span: the svg is injected. */
    .wx__icon :global(svg) {
      width: 32px;
      height: 35px;
    }

    .wx__temp {
      font-size: 2.125rem;
    }

    .wx__meta {
      margin-top: 0.8rem;
      padding-top: 0.7rem;
    }
  }

  @media (min-width: 768px) {
    .wx {
      width: 17.5rem;
      flex: none;
      margin-top: 0;
    }
  }

  /* Blur is expensive on low end phones and pointless where it is unsupported.
     Fall back to a flat tint that hits the same contrast. */
  @supports not (backdrop-filter: blur(4px)) {
    .wx {
      background: color-mix(in srgb, var(--color-ink) 72%, transparent);
    }
  }
</style>
