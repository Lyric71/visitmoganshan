---
import { STATS } from '../../data/stats';

/**
 * 6.8 Orientation strip. Four tiles, hairline dividers, no card shadows.
 *
 * These are real text, never an image of text. They are the fastest crawlable
 * answer to "where is Moganshan" and "how far is Moganshan from Shanghai"
 * anywhere on the site, and they sit low on the page, so they need every bit of
 * crawl equity they can carry. Each tile links to the page that proves its
 * figure; a number with nothing behind it is a liability.
 */
---

<section class="strip" aria-labelledby="orientation-title">
  <div class="vm-container">
    <h2 id="orientation-title" class="sr-only">Moganshan at a glance</h2>
    <ul class="strip__grid">
      {
        STATS.map((stat) => (
          <li>
            <a href={stat.href}>
              <span class="strip__value">{stat.value}</span>
              <span class="strip__label">{stat.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .strip {
    background: var(--color-mist);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hairlines, drawn as borders on the cells rather than as separate rules, so
     the 2x2 and 4-up arrangements both close up correctly. */
  .strip__grid > li {
    border-top: 1px solid var(--color-line);
  }

  .strip__grid > li:nth-child(odd) {
    border-right: 1px solid var(--color-line);
  }

  .strip__grid a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.25rem 1rem 1.25rem 0;
    text-decoration: none;
  }

  .strip__grid > li:nth-child(odd) a {
    padding-right: 1.25rem;
  }

  .strip__grid > li:nth-child(even) a {
    padding-left: 1.25rem;
  }

  .strip__value {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 500;
    line-height: 1.1;
    color: var(--color-bamboo);
  }

  .strip__label {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .strip__grid a:hover .strip__label {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 860px) {
    .strip__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .strip__grid > li:nth-child(odd) {
      border-right: 0;
    }

    .strip__grid > li + li {
      border-left: 1px solid var(--color-line);
    }

    .strip__grid > li:nth-child(even) a,
    .strip__grid > li:nth-child(odd) a {
      padding-inline: 1.5rem;
    }

    .strip__grid > li:first-child a {
      padding-left: 0;
    }
  }
</style>
