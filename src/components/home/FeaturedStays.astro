---
import { propertyArticles } from '../../lib/home';
import { TYPE_LABEL, TYPE_ORDER, countOfType, typePath } from '../../lib/stays';

/**
 * Properties with a page of their own, as a magazine spread: one large frame
 * on the left and the rest as a column of small frames on the right, then a
 * row of the seven kinds of place with their counts.
 *
 * The directory tabs below sample five cards per kind from the 809 row
 * directory, and nothing on those cards is written here. This block is the
 * opposite: the few properties that have earned a researched page, each with
 * our own photograph, our own description and sourced guest excerpts. It is
 * derived from the guide collection, so a new hotel article appears here on
 * publish.
 *
 * Alphabetical, not ranked. The first frame is the first name in the
 * alphabet, and the layout says nothing about which is best: the reading
 * list at the foot is where the choosing gets done.
 */
const properties = await propertyArticles();
const [lead, ...rest] = properties;

const READING = [
  { title: 'How to choose', href: '/where-to-stay/best-hotels' },
  { title: 'What a minsu is', href: '/where-to-stay/minsu-explained' },
  { title: 'Every hotel, named', href: '/where-to-stay/hotels-explained' },
  { title: 'Private villas', href: '/where-to-stay/villas-explained' },
  { title: 'Luxury on the mountain', href: '/where-to-stay/luxury' },
];

const clean = (url: string) => url.replace(/\/+$/, '');
---

<section class="vm-section stays" aria-labelledby="featured-stays-title">
  <div class="vm-container">
    <div class="head" data-reveal>
      <h2 id="featured-stays-title">Places we have written up</h2>
      <p class="head__lede">
        Four properties with a researched page each: our photographs, our description, and what
        guests said, with sources. The directory of every other place follows.
      </p>
    </div>

    {
      lead && (
        <div class="spread">
          <a class="lead" href={clean(lead.data.url)} data-reveal>
            <img
              src={lead.data.image}
              alt={lead.data.image_alt}
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <span class="lead__text">
              <span class="lead__title">{lead.data.title}</span>
              <span class="lead__sub">{lead.data.excerpt}</span>
            </span>
          </a>

          <ul class="stack">
            {rest.map((entry, i) => (
              <li style={`--i:${i + 1}`} data-reveal>
                <a class="row" href={clean(entry.data.url)}>
                  <span class="row__media">
                    <img
                      src={entry.data.image}
                      alt={entry.data.image_alt}
                      width="400"
                      height="267"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="row__text">
                    <span class="row__title">{entry.data.title}</span>
                    <span class="row__sub">{entry.data.excerpt}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="foot" data-reveal>
      <ul class="types" aria-label="Kinds of place to stay">
        {
          TYPE_ORDER.map((type) => (
            <li>
              <a class="chip" href={typePath(type)}>
                {TYPE_LABEL[type]}
                <span class="chip__count">{countOfType(type).toLocaleString('en-GB')}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="reading">
        <span class="reading__label">Before you book</span>
        {
          READING.map((item, i) => (
            <>
              {i > 0 && <span class="reading__sep" aria-hidden="true" />}
              <a href={item.href}>{item.title}</a>
            </>
          ))
        }
      </p>
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 62ch;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .head h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .head__lede {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .spread {
      grid-template-columns: 1.4fr 1fr;
      gap: 1.5rem;
      align-items: stretch;
    }
  }

  /* --- The lead frame --- */

  .lead {
    position: relative;
    display: block;
    min-height: 320px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-stone);
    text-decoration: none;
    isolation: isolate;
  }

  @media (min-width: 900px) {
    .lead {
      min-height: 480px;
    }
  }

  .lead img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lead::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-ink) 82%, transparent) 0%,
      color-mix(in srgb, var(--color-ink) 34%, transparent) 42%,
      transparent 70%
    );
  }

  .lead:hover img {
    transform: scale(1.04);
  }

  .lead__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.6vw, 1.75rem);
  }

  .lead__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 2.125rem);
    font-weight: 500;
    line-height: 1.15;
    color: #fff;
  }

  .lead__sub {
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-mist);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- The stack --- */

  .stack {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .stack {
      grid-template-rows: repeat(3, minmax(0, 1fr));
    }
  }

  .row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 1rem;
    height: 100%;
    padding: 0.625rem;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
    text-decoration: none;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 200ms ease,
      box-shadow 400ms ease;
  }

  .row:hover {
    transform: translateY(-3px);
    border-color: var(--color-bamboo);
    box-shadow: 0 22px 40px -28px color-mix(in srgb, var(--color-bamboo) 55%, transparent);
  }

  .row__media {
    display: block;
    align-self: stretch;
    min-height: 92px;
    border-radius: 9px;
    overflow: hidden;
    background: var(--color-stone);
  }

  .row__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .row:hover .row__media img {
    transform: scale(1.06);
  }

  .row__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem 0.25rem 0;
  }

  .row__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-bamboo);
  }

  .row__sub {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* --- The foot --- */

  .foot {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-bamboo);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .chip:hover {
    border-color: var(--color-bamboo);
    background: var(--color-mist-50);
  }

  .chip__count {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 0.6rem;
    border-radius: 999px;
    background: var(--color-mist);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .reading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }

  .reading__label {
    font-weight: 600;
    color: var(--color-ink);
  }

  .reading a {
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .reading__sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-line);
  }

  @media (prefers-reduced-motion: reduce) {
    .lead img,
    .row,
    .row__media img {
      transition: none;
    }

    .lead:hover img,
    .row:hover,
    .row:hover .row__media img {
      transform: none;
    }
  }
</style>
