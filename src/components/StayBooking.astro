---
import StayGallery from './StayGallery.astro';
import StayComments from './StayComments.astro';
import { goPath, type StayEntry } from '../lib/stays';

/**
 * The commercial half of a property page, dropped into the foot of an article.
 *
 * A guide page carrying `stay_id` is the one page for that hotel, so everything
 * the property template would have shown has to arrive here instead: the
 * photographs the property actually supplied, what guests said, the rating, the
 * button and the disclosure. What it does not bring is a second description or
 * a second honest note. The article above already is both, at greater length
 * and with sources, and repeating a shorter version underneath would be the
 * page arguing with itself.
 *
 * Order matters as much as it does on the property template. Photographs, then
 * other people's words, then the button. Never the button first.
 */
interface Props {
  entry: StayEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const go = goPath(data.affiliate.goSlug);
---

<section class="booking" aria-labelledby="booking-title">
  <h2 id="booking-title">Photographs, guests and rates</h2>
  <p class="booking__intro">
    The frames below are the property's own listing images, supplied through Trip.com rather than
    taken by us. The article above is what we could verify independently; this is what the property
    and its guests say for themselves.
  </p>

  <StayGallery images={data.images} name={data.name} />

  <StayComments
    comments={data.comments}
    rating={data.rating}
    reviewsUrl={data.comments[0].sourceUrl}
  />

  <div class="cta">
    <p class="cta__line">
      Rates and availability change daily and we do not hold either. This link opens the property on
      Trip.com.
    </p>
    <a class="vm-btn" href={go} rel="sponsored noopener" target="_blank">
      Check dates on Trip.com
      <span class="vm-sr-only"> (opens in a new tab)</span>
    </a>
    <p class="cta__disclosure">
      We may earn a commission if you book through this link, at no cost to you.{' '}
      <a href="/plan/disclosure">How this site is funded</a>. It changes nothing above.
    </p>
  </div>
</section>

<style>
  .booking {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
  }

  .booking h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .booking__intro {
    max-width: 62ch;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .cta {
    padding-top: clamp(1.5rem, 3vw, 2rem);
  }

  .cta__line {
    max-width: 58ch;
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .cta__disclosure {
    max-width: 58ch;
    margin-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .cta__disclosure a {
    color: var(--color-bamboo);
  }
</style>
