---
import StayCard from './StayCard.astro';
import StayFilters from './StayFilters.astro';
import PageHero from './PageHero.astro';
import { CAPTURES, priceBand } from '../lib/captures';
import { STAY_TYPE_INTROS, renderIntro } from '../data/stay-types';
import {
  TYPE_LABEL,
  typeAllUrl,
  typePageUrl,
  type SeedRecord,
  type StayType,
} from '../lib/stays';

/**
 * One page of the properties of one kind, as cards.
 *
 * A card carries what Trip.com actually holds about a place: photographs, its
 * summary of what guests keep saying, one excerpt in a guest's own words, the
 * caveat the unhappy ones raised, and the score. A row with a name and a button
 * was not a listing, it was an index, and nobody chooses where to sleep from an
 * index.
 *
 * Above the cards on the first page sits the one part of the page that is
 * ours: a few hundred words on what this kind of place means on this mountain,
 * what it costs and what to ask before paying. Without it the page was a
 * heading and four hundred captured cards, which is a page a search engine is
 * right to discount.
 *
 * The rows arrive already sorted, most reviewed first, and already cut to a
 * page by the route. This component does not know how many pages there are
 * unless it is told, and when it is not told (the /all view) it renders the
 * lot with no pagination.
 */
interface Props {
  type: StayType;
  /** hotelId to the page we have written about it, where one exists. */
  writtenUp: Map<number, string>;
  /** The rows for this page, in display order. */
  rows: SeedRecord[];
  /** How many properties of this kind there are in all. */
  total: number;
  /** Absent on the single-page view. `start` and `end` are 1-based row numbers. */
  page?: { current: number; last: number; start: number; end: number };
}

const { type, writtenUp, rows, total, page } = Astro.props;

const label = TYPE_LABEL[type];
const isFirst = !page || page.current === 1;
const paginated = Boolean(page && page.last > 1);
const intro = renderIntro(STAY_TYPE_INTROS[type], total);

const unpriced = rows.filter((row) => priceBand(CAPTURES.get(row.id)) === 'unknown').length;

// The pagination strip lists every page. Seven pages is the most any type
// runs to, which is short enough to show in full rather than elide.
const pages = page ? Array.from({ length: page.last }, (_, i) => i + 1) : [];
---

<PageHero
  title={`${label} around Moganshan`}
  kicker="Where to stay"
  standfirst={isFirst ? intro.standfirst : undefined}
>
  <p class="opening__byline">
    <strong>{total.toLocaleString('en-GB')} bookable</strong>
    <span>Ordered by review count, most first</span>
    {page && page.last > 1 && <span>Page {page.current} of {page.last}</span>}
  </p>
</PageHero>

<section class="listing vm-container">
  {
    isFirst ? (
      <div class="listing__intro">
        {intro.paragraphs.map((paragraph) => (
          <p set:html={paragraph} />
        ))}
        <p class="listing__method">
          The kind of place is read from the name each property gives itself on Trip.com, not from an
          inspection of ours. Photographs, scores, summaries and quotes on the cards are captured from
          the same listings; nothing on a card is written by us.
        </p>
      </div>
    ) : (
      <p class="listing__where">
        Page {page!.current} of {page!.last}, properties {page!.start.toLocaleString('en-GB')} to{' '}
        {page!.end.toLocaleString('en-GB')} of {total.toLocaleString('en-GB')}, most reviewed first.
        The introduction to this list is on <a href={typePageUrl(type, 1)}>the first page</a>.
      </p>
    )
  }

  <StayFilters
    total={rows.length}
    unpriced={unpriced}
    scope={paginated ? { total, allHref: typeAllUrl(type) } : undefined}
  />

  <div class="cards">
    {rows.map((row) => <StayCard row={row} href={writtenUp.get(row.id)} />)}
  </div>

  {
    paginated && (
      <nav class="pages" aria-label="Pages of this list">
        <p class="pages__where">
          Showing {page!.start.toLocaleString('en-GB')} to {page!.end.toLocaleString('en-GB')} of{' '}
          {total.toLocaleString('en-GB')}
        </p>
        <ol role="list">
          {page!.current > 1 && (
            <li>
              <a href={typePageUrl(type, page!.current - 1)} rel="prev">
                Previous
              </a>
            </li>
          )}
          {pages.map((n) => (
            <li>
              {n === page!.current ? (
                <span aria-current="page">{n}</span>
              ) : (
                <a href={typePageUrl(type, n)}>{n}</a>
              )}
            </li>
          ))}
          {page!.current < page!.last && (
            <li>
              <a href={typePageUrl(type, page!.current + 1)} rel="next">
                Next
              </a>
            </li>
          )}
        </ol>
        <p class="pages__all">
          <a href={typeAllUrl(type)}>All {total.toLocaleString('en-GB')} on one page</a>, for searching by
          name.
        </p>
      </nav>
    )
  }
</section>

<style>
  .listing {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  /* Intro ------------------------------------------------------------------ */

  /* The intro holds a reading measure: it is a few hundred words of our own
     prose, and it is read, where the cards below are scanned. */
  .listing__intro {
    max-width: 68ch;
    text-wrap: pretty;
  }

  .listing__intro p {
    line-height: 1.65;
  }

  .listing__intro p + p {
    margin-top: 0.9rem;
  }

  .listing__intro a {
    color: var(--color-bamboo);
    text-underline-offset: 3px;
  }

  .listing__method {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .listing__where {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .listing__where a {
    color: var(--color-bamboo);
  }

  .cards {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* Pagination ------------------------------------------------------------- */

  .pages {
    padding-block: clamp(1.5rem, 3vw, 2rem);
  }

  .pages__where,
  .pages__all {
    margin: 0;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .pages__all {
    margin-top: 0.9rem;
  }

  .pages__all a {
    color: var(--color-bamboo);
    font-weight: 600;
  }

  .pages ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pages li a,
  .pages li span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    color: var(--color-bamboo);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .pages li a:hover,
  .pages li a:focus-visible {
    background: var(--color-mist-50);
    border-color: var(--color-bamboo);
  }

  .pages li span[aria-current] {
    color: var(--color-mist);
    background: var(--color-bamboo);
    border-color: var(--color-bamboo);
    font-weight: 600;
  }
</style>
