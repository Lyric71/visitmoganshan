---
import Lockup from './Lockup.astro';
import { TYPE_LABEL, TYPE_ORDER, typePath } from '../lib/stays';

/**
 * Four columns on bamboo with mist type (8.43:1, AAA).
 *
 * Stay reproduces the header's "Where to stay" column rather than restating it,
 * and reads from TYPE_ORDER for the same reason the header does: a type added
 * there appears in both menus without a second edit. A footer that disagrees
 * with the header about what the site contains is worse than no footer.
 */
const STAY_TYPE_LINKS = TYPE_ORDER.map((type) => ({
  label: TYPE_LABEL[type],
  href: typePath(type),
}));
const COLUMNS = [
  {
    title: 'Discover',
    links: [
      { label: 'The mountain', href: '/moganshan' },
      { label: 'Villages', href: '/moganshan/villages' },
      { label: 'The hill station', href: '/moganshan/hill-station' },
      { label: 'Bamboo forest', href: '/moganshan/bamboo-forest' },
    ],
  },
  {
    title: 'Practical',
    links: [
      { label: 'Getting here', href: '/getting-here' },
      { label: 'Tickets', href: '/plan/tickets-and-entry' },
      { label: 'Weather', href: '/moganshan/weather' },
      { label: 'Accessibility', href: '/plan/accessibility' },
    ],
  },
  {
    title: 'Where to stay',
    links: STAY_TYPE_LINKS,
    // Seven against four leaves this column running well past its neighbours.
    // Split into two so the row of columns ends roughly level.
    split: true,
  },
];

/**
 * Second level. Not a destination column: these are about the publisher, not
 * about the mountain, and a reader scanning the footer for somewhere to go
 * should not have them competing with the three that are.
 *
 * Still above the legal line, because somebody hunting for the contact page
 * should not have to read past the cookie policy to find it.
 */
const SECONDARY = [
  { label: 'About this site', href: '/about' },
  { label: 'Trade and media', href: '/trade' },
  { label: 'Contact', href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="vm-container">
    <div class="footer__grid">
      {
        COLUMNS.map((column) => (
          <nav
            class:list={['footer__col', column.split && 'footer__col--split']}
            aria-label={column.title}
          >
            <h2 class="footer__col-title">{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer__brand">
      <Lockup reversed />
      <!-- 莫干山 lives here and on the About page, never in the header. The face
           is not bundled; the stack falls through to whatever serif CJK the OS
           has. TODO: self-host a Noto Serif SC subset of these three glyphs. -->
      <p class="footer__cjk" lang="zh-Hans">莫干山</p>
    </div>

    <nav class="footer__secondary" aria-label="About this site">
      <ul>
        {
          SECONDARY.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__base">
      <p>
        &copy; {year} Visit Moganshan · <a href="/sitemap">Sitemap</a> · <a href="/privacy"
          >Privacy</a
        > · <a href="/terms">Terms</a> · <a href="/cookies">Cookies</a> · <a
          href="/user-generated-content">Content terms</a
        > · <a href="/plan/disclosure">How this site is funded</a> · <a href="/admin">Admin</a>
      </p>
      <!-- A plain fragment link, so it works with scripting off and lands on the
           skip link rather than mid-header. -->
      <p class="footer__top"><a href="#top">Back to top ↑</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bamboo);
    color: var(--color-mist);
    padding-block: clamp(3.5rem, 7vw, 5rem) 2.5rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .footer__col-title {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .footer__col ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--color-mist);
  }

  .footer__col a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Only once the footer itself has gone wide. Below that the column is already
     half a phone wide, and splitting it again wraps every label. */
  @media (min-width: 768px) {
    .footer__col--split ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
    }
  }

  .footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-mist) 18%, transparent);
  }

  .footer__cjk {
    font-family: var(--font-cjk);
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    color: var(--color-mist-muted);
  }

  /* Between the columns and the legal line, and weighted between them: mist
     type like a column link, inline like the legal row. */
  .footer__secondary ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer__secondary a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--color-mist);
  }

  .footer__secondary a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-mist) 12%, transparent);
    font-size: 0.8125rem;
    color: var(--color-mist-muted);
  }

  .footer__base a {
    color: var(--color-mist-muted);
  }

  .footer__base a:hover {
    color: var(--color-mist);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Last item on mobile, where the legal row wraps and the reader has just
     scrolled the length of a guide page. Pushed to its own end column on wide
     screens so it reads as a control, not as another legal link. */
  .footer__top {
    flex: 1 0 100%;
  }

  @media (min-width: 768px) {
    .footer__top {
      flex: 0 0 auto;
      text-align: right;
    }
  }

  /* The split column carries two lists, so it takes two shares of the row. */
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 2fr;
    }
  }
</style>
