#!/bin/bash
# Refuse to push unoptimized images.
# Installed by `npm run hooks:install`. See scripts/audit-images.mjs.
#
# Vercel image optimization is off on this site, so whatever is committed is
# byte for byte what a reader downloads. There is no CDN step later that will
# catch a 3 MB PNG, which is why this gate sits here rather than in review.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! node scripts/audit-images.mjs; then
  echo ""
  echo "Push blocked: unoptimized images under public/."
  echo "Re-encode them with: npm run img <path> --out=public/images/<dir>"
  exit 1
fi

# Refuse to push an article whose text changed but whose date did not. The
# byline prints last_updated and the structured data repeats it, so a stale
# one is a wrong fact on the page rather than a housekeeping slip.
if ! node scripts/check-dates.mjs; then
  echo ""
  echo "Push blocked: an article changed without its last_updated moving."
  exit 1
fi

# Refuse to push published content that still carries a TODO. A publishing
# job closes what it finds inside the run; nothing ships as a marker.
if ! node scripts/check-todos.mjs; then
  echo ""
  echo "Push blocked: a TODO, FIXME, TBD or XXX marker in src/content."
  exit 1
fi
